{
  "name": "@vubon/auth-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "start:debug": "tsx --inspect-brk watch src/main.ts",
    "start:prod": "node dist/main.js",
    "test": "echo \"No tests yet\" && exit 0",
    "prisma:generate": "pnpm exec prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^10.3.0",
    "@prisma/client": "^5.22.0",
    "@vubon/auth-shared-config": "workspace:*",
    "@vubon/auth-shared-constants": "workspace:*",
    "@vubon/auth-shared-schemas": "workspace:*",
    "@vubon/auth-shared-types": "workspace:*",
    "@vubon/auth-shared-utils": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.3.0",
    "@prisma/client": "^5.22.0",
    "@swc/cli": "^0.3.0",
    "@swc/core": "^1.3.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.8.0",
    "eslint": "^9.39.5",
    "prettier": "^3.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}