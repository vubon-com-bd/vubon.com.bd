{
  "name": "vubon-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm run build --workspaces",
    "type-check": "pnpm run type-check --workspaces",
    "lint": "pnpm run lint --workspaces",
    "format": "pnpm run format --workspaces",
    "format:check": "pnpm run format:check --workspaces",
    "test": "pnpm run test --workspaces",
    "check": "pnpm run format:check && pnpm run lint && pnpm run type-check && pnpm run test",
    "prisma:generate": "pnpm --filter @vubon/auth-service prisma generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
