# ═══════════════════════════════════════════════════════════════════
# Vubon.com.bd — ROOT Environment Variables (SHARED)
# ═══════════════════════════════════════════════════════════════════

# ─── Global ────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
TZ=Asia/Dhaka

# ─── App ───────────────────────────────────────────────────────────
APP_NAME=Vubon
APP_VERSION=1.0.0
APP_PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# ─── Database (Supabase — shared) ──────────────────────────────────
DATABASE_URL="postgresql://postgres.dlwleiknrxqrwtswcumw:Md_539355393@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.dlwleiknrxqrwtswcumw:Md_539355393@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT_MS=5000
DB_DRIVER=postgres
DB_SSL=false
DB_LOGGING=true
DB_SYNCHRONIZE=false
DB_TIMEZONE=Asia/Dhaka
DB_SCHEMA=public
DB_MAX_CONNECTIONS=100
DB_STATEMENT_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=10000

# ─── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=vubon:
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=3000
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY_MS=200
REDIS_RETRY_BACKOFF=2
REDIS_ENABLE_OFFLINE_QUEUE=true
REDIS_ENABLE_READY_CHECK=true
REDIS_LAZY_CONNECT=false
REDIS_KEEP_ALIVE_MS=30000

# ─── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=your-256-bit-secret-min-32-chars-change-in-prod
JWT_ISSUER=vubon-api
JWT_AUDIENCE=vubon-client
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ALGORITHM=HS256

# ─── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173

# ─── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# ─── Feature Flags ─────────────────────────────────────────────────
FF_NEW_CHECKOUT=false
FF_AI_RECOMMENDATION=true
FF_DARK_MODE=true

# ─── Email ─────────────────────────────────────────────────────────
EMAIL_ENABLED=true
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=noreply@vubon.com.bd
EMAIL_SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@vubon.com.bd
EMAIL_FROM_NAME=Vubon

# ─── SMS ───────────────────────────────────────────────────────────
SMS_ENABLED=false
SMS_PROVIDER=sslwireless
SMS_API_KEY=
SMS_SENDER_ID=Vubon

# ─── Storage ───────────────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_URL=http://localhost:3000/storage

# ═══════════════════════════════════════════════════════════════════
# PRODUCT SERVICE — shared variables (used by product-service)
# ═══════════════════════════════════════════════════════════════════

# ─── Service Port ──────────────────────────────────────────────────
PRODUCT_SERVICE_PORT=4002

# ─── Search Engine (Meilisearch / Elasticsearch / Typesense) ──────
SEARCH_PROVIDER=meilisearch
SEARCH_HOST=http://localhost:7700
SEARCH_API_KEY=masterKey-change-in-prod
SEARCH_PRODUCT_INDEX=products
SEARCH_CATEGORY_INDEX=categories
SEARCH_BATCH_SIZE=100
SEARCH_TIMEOUT_MS=5000
SEARCH_RETRY_ATTEMPTS=3

# ─── Storage (S3 / GCS / local) ───────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_BASE_PATH=./storage/uploads
STORAGE_S3_BUCKET=vubon-media
STORAGE_S3_REGION=ap-southeast-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_CDN_URL=https://cdn.vubon.com.bd

# ─── Queue (BullMQ uses Redis) ────────────────────────────────────
REDIS_QUEUE_DB=1
QUEUE_CONCURRENCY=5
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_DELAY_MS=5000

# ─── Media Limits ─────────────────────────────────────────────────
MEDIA_IMAGE_MAX_SIZE_MB=5
MEDIA_VIDEO_MAX_SIZE_MB=100
MEDIA_DOCUMENT_MAX_SIZE_MB=10
MEDIA_IMAGE_QUALITY=85
MEDIA_IMAGE_MAX_WIDTH=2048
MEDIA_THUMBNAIL_WIDTH=400

# ─── Cache TTLs (seconds) ─────────────────────────────────────────
PRODUCT_CACHE_TTL=300
PRODUCT_LIST_CACHE_TTL=180
VARIANT_CACHE_TTL=300
INVENTORY_CACHE_TTL=60
PRICING_CACHE_TTL=300
REVIEW_CACHE_TTL=120
BRAND_CACHE_TTL=600
CATEGORY_TREE_CACHE_TTL=600

# ─── Pagination ───────────────────────────────────────────────────
PRODUCT_PAGE_SIZE=20
PRODUCT_MAX_PAGE_SIZE=100

# ─── Feature Flags (product-service) ──────────────────────────────
PRODUCT_SEARCH_INDEXING=true
VARIANT_AUTO_MATRIX=true
INVENTORY_LOW_STOCK_ALERTS=true
REVIEW_AUTO_APPROVE=false

# ═══════════════════════════════════════════════════════════════════
# CART SERVICE — shared variables (used by cart-service)
# ═══════════════════════════════════════════════════════════════════

# ─── Service Port ──────────────────────────────────────────────────
CART_SERVICE_PORT=4003

# ─── Cart Config ──────────────────────────────────────────────────
CART_DEFAULT_CURRENCY=BDT
CART_DEFAULT_TYPE=user
CART_USER_TTL_HOURS=720
CART_GUEST_TTL_HOURS=168
CART_REDIS_TTL=604800
CART_CACHE_TTL=300
CART_MAX_ITEMS=100
CART_MAX_QTY_PER_ITEM=999
CART_MIN_QTY_PER_ITEM=1
CART_MAX_COUPONS=1
CART_MAX_VOUCHERS=1
CART_MAX_SAVED_ITEMS=100
CART_EXPIRY_SCAN_INTERVAL_MS=3600000

# ─── Guest Cart ───────────────────────────────────────────────────
GUEST_TOKEN_BYTES=32

# ─── Coupon ───────────────────────────────────────────────────────
COUPON_CACHE_TTL=60

# ─── Abandonment ──────────────────────────────────────────────────
ABANDONED_ENABLED=true
ABANDONED_THRESHOLD_HOURS=24
ABANDONED_MAX_REMINDERS=4
ABANDONED_DISCOUNT_PERCENT=10
ABANDONED_EXPIRY_DAYS=30
ABANDONED_TRACK_OPENS=true
ABANDONED_TRACK_CLICKS=true

# ─── Reminders ────────────────────────────────────────────────────
REMINDER_EMAIL_ENABLED=true
REMINDER_SMS_ENABLED=false
REMINDER_PUSH_ENABLED=true
REMINDER_FIRST_HOURS=1
REMINDER_SECOND_HOURS=24
REMINDER_THIRD_HOURS=72
REMINDER_FINAL_HOURS=168

# ─── Queue (BullMQ — cart-specific) ───────────────────────────────
CART_QUEUE_DB=2
CART_QUEUE_CONCURRENCY=5
