# ============================================================
# Vubon — Environment Variables (example)
# Copy to .env and fill real values. NEVER commit .env
# ============================================================

# App
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
API_VERSION=v1
LOG_LEVEL=info
TIMEZONE=Asia/Dhaka
LOCALE=bn-BD
CURRENCY=BDT

# Database (password REQUIRED)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me_in_env
DB_NAME=vubon
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (REQUIRED, min 32 chars)
JWT_SECRET=change_me_min_32_characters_long_xxxxx
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Encryption (REQUIRED, 64 hex chars)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_IV=

# Session (REQUIRED, min 32 chars)
SESSION_SECRET=change_me_session_secret_min_32_chars_xxx

# Device Fingerprint (REQUIRED, min 16 chars)
DEVICE_FINGERPRINT_SALT=change_me_device_salt

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# SMS
SMS_API_KEY=
SMS_API_SECRET=

# Payment Gateways
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=

# SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
