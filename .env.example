# ============================================
# Vubon.com.bd — Environment Variables Template
# ============================================

# Node Environment
NODE_ENV=development

# API
API_PORT=4000
API_URL=http://localhost:4000

# JWT
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ISSUER=vubon-api
JWT_AUDIENCE=vubon-client

# CORS (comma separated, no wildcards in production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Session Cookie
SESSION_COOKIE_DOMAIN=.vubon.com.bd

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vubon

# Redis
REDIS_URL=redis://localhost:6379

# Cache
CACHE_TTL=3600

# Log
LOG_LEVEL=debug
