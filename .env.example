# ═══════════════════════════════════════════════════════════════════════════
# Vubon Platform — Complete Environment Variables Example
# ═══════════════════════════════════════════════════════════════════════════
#
# USAGE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in real values in .env
#   3. NEVER commit .env to git
#
# CONVENTIONS:
#   - ALL env vars use UPPER_SNAKE_CASE
#   - Secrets have EMPTY default (never a real value)
#   - Optional features default to DISABLED (false)
#   - Time units in var name: _MS, _SECONDS, _MINUTES, _HOURS, _DAYS
#   - Sizes in var name: _MB, _KB, _BYTES
#   - URLs must include protocol (http:// or https://)
# ═══════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
# 1. CORE ENVIRONMENT
# ───────────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=Vubon
APP_VERSION=1.0.0
APP_PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api
ADMIN_URL=http://localhost:3001
CDN_URL=
DOCS_URL=
LOG_LEVEL=debug


# ───────────────────────────────────────────────────────────────────────────
# 2. DATABASE
# ───────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/vubon
DB_DRIVER=postgres
DB_SSL=false
DB_LOGGING=true
DB_SYNCHRONIZE=false
DB_TIMEZONE=Asia/Dhaka
DB_SCHEMA=public
DB_MAX_CONNECTIONS=100
DB_STATEMENT_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=10000

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vubon
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SSL=false
POSTGRES_APP_NAME=vubon-api

# MongoDB (optional)
MONGODB_URI=
MONGODB_DB=vubon

# Pool
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_POOL_TEST_ON_BORROW=true

# Migration
MIGRATION_ENABLED=true
MIGRATION_AUTO_RUN=false
MIGRATION_DIR=./migrations
MIGRATION_TABLE=migrations


# ───────────────────────────────────────────────────────────────────────────
# 3. REDIS
# ───────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=vubon:
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=3
REDIS_LAZY_CONNECT=false

# Redis Cache
REDIS_CACHE_DB=1
REDIS_CACHE_DEFAULT_TTL=3600
REDIS_CACHE_MAX_TTL=2592000

# Redis Queue
REDIS_QUEUE_DB=2
REDIS_QUEUE_CONCURRENCY=5


# ───────────────────────────────────────────────────────────────────────────
# 4. QUEUE & JOBS
# ───────────────────────────────────────────────────────────────────────────
QUEUE_DRIVER=bull
QUEUE_ENABLED=true
QUEUE_WORKER_CONCURRENCY=5
QUEUE_DEFAULT_PRIORITY=2
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_DEFAULT_BACKOFF_MS=5000

# Bull/BullMQ
BULL_CONCURRENCY=5
BULL_METRICS=true

# RabbitMQ (optional)
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_VHOST=/

# Job Scheduler
JOB_SCHEDULER_ENABLED=true
JOB_SCHEDULER_INTERVAL_MS=60000


# ───────────────────────────────────────────────────────────────────────────
# 5. CACHE
# ───────────────────────────────────────────────────────────────────────────
CACHE_DRIVER=redis
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=3600
CACHE_KEY_PREFIX=vubon:cache:

# Memory Cache
MEMORY_CACHE_ENABLED=true
MEMORY_CACHE_MAX_KEYS=10000
MEMORY_CACHE_MAX_MEMORY_MB=512


# ───────────────────────────────────────────────────────────────────────────
# 6. SESSION
# ───────────────────────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_SECRET=replace-with-32-char-minimum-session-secret
SESSION_NAME=vubon.sid
SESSION_TTL_SECONDS=86400
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_STORE_DRIVER=redis


# ───────────────────────────────────────────────────────────────────────────
# 7. STORAGE
# ───────────────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_BUCKET=vubon-files
STORAGE_REGION=ap-south-1
STORAGE_ROOT_PREFIX=uploads
STORAGE_PUBLIC_READ=false
STORAGE_MAX_FILE_SIZE_MB=25
STORAGE_SIGNED_URL_EXPIRY_SECONDS=3600

# S3
S3_ENABLED=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-south-1
S3_BUCKET=

# GCS
GCS_ENABLED=false
GCS_PROJECT_ID=
GCS_BUCKET=
GCS_KEY_FILENAME=

# Azure Blob
AZURE_BLOB_ENABLED=false
AZURE_BLOB_ACCOUNT=
AZURE_BLOB_KEY=
AZURE_BLOB_CONTAINER=vubon-files

# Local Storage
LOCAL_STORAGE_ENABLED=true
LOCAL_STORAGE_DIR=./storage/uploads
LOCAL_STORAGE_BASE_URL=/uploads

# CDN
CDN_ENABLED=false
CDN_PROVIDER=cloudfront
CDN_BASE_URL=


# ───────────────────────────────────────────────────────────────────────────
# 8. SECURITY
# ───────────────────────────────────────────────────────────────────────────
# CORS
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true
CORS_MAX_AGE_SECONDS=86400

# Helmet / CSP
HELMET_ENABLED=true
CSP_ENABLED=true
CSP_REPORT_ONLY=false
CSP_REPORT_URI=
HSTS_ENABLED=true
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Rate Limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DRIVER=redis
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# CSRF
CSRF_ENABLED=true
CSRF_COOKIE_NAME=vubon.csrf
CSRF_TOKEN_TTL_SECONDS=3600

# XSS
XSS_PROTECTION_ENABLED=true
XSS_BLOCK_ON_DETECTION=false

# SQL Injection
SQL_INJECTION_PROTECTION_ENABLED=true
SQL_BLOCK_ON_DETECTION=true

# Brute Force
BRUTE_FORCE_ENABLED=true
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_WINDOW_MS=900000
BRUTE_FORCE_BLOCK_MS=900000

# Account Lock
ACCOUNT_LOCK_ENABLED=true
ACCOUNT_LOCK_AUTO_UNLOCK=true


# ───────────────────────────────────────────────────────────────────────────
# 9. JWT
# ───────────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-32-char-minimum-secret-key
JWT_ISSUER=vubon-api
JWT_AUDIENCE=vubon-client
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ALGORITHM=HS256
JWT_HEADER_NAME=authorization
JWT_BEARER_PREFIX=Bearer
REFRESH_TOKEN_ROTATE=true
REFRESH_TOKEN_REVOKE_ON_REUSE=true


# ───────────────────────────────────────────────────────────────────────────
# 10. AUTH
# ───────────────────────────────────────────────────────────────────────────
# Password
PASSWORD_ALGO=bcrypt
BCRYPT_ENABLED=true
ARGON2_ENABLED=false
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
PASSWORD_MAX_RESET_ATTEMPTS=3

# MFA
MFA_ENABLED=true
MFA_REQUIRE_FOR_ADMIN=true
TOTP_ISSUER=Vubon
RECOVERY_CODE_REGENERATE=true

# Auth Session
AUTH_SESSION_ENABLED=true
AUTH_SESSION_COOKIE=vubon.auth
AUTH_SESSION_COOKIE_HTTP_ONLY=true
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_SAME_SITE=lax
SESSION_ROTATION_ENABLED=true
SESSION_REUSE_DETECTION=true

# Device
AUTH_DEVICE_TRACKING=true
AUTH_NOTIFY_NEW_DEVICE=true
FINGERPRINT_ENABLED=true

# Verification
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_REQUIRED=true
PHONE_VERIFICATION_ENABLED=true
PHONE_VERIFICATION_REQUIRED=false

# OAuth
OAUTH_ENABLED=true
OAUTH_PKCE_ENABLED=true

GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

FACEBOOK_OAUTH_ENABLED=false
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

APPLE_OAUTH_ENABLED=false
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=

# SSO
SAML_ENABLED=false
SAML_ENTRY_POINT=
SAML_ISSUER=vubon
SAML_CERT=
SAML_CALLBACK_URL=

OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Biometric
BIOMETRIC_ENABLED=false
BIOMETRIC_RP_NAME=Vubon
BIOMETRIC_RP_ID=localhost
BIOMETRIC_ORIGIN=http://localhost:3000


# ───────────────────────────────────────────────────────────────────────────
# 11. FEATURE FLAGS
# ───────────────────────────────────────────────────────────────────────────
FF_NEW_CHECKOUT=false
FF_AI_RECOMMENDATION=true
FF_DARK_MODE=true
FF_LIVE_CHAT=false
FF_LOYALTY_PROGRAM=true
FF_REFERRAL_PROGRAM=true
FF_MULTI_VENDOR=true
FF_FLASH_SALES=true


# ───────────────────────────────────────────────────────────────────────────
# 12. OBSERVABILITY
# ───────────────────────────────────────────────────────────────────────────
LOG_CONSOLE=true
LOG_FILE=false
LOG_FILE_PATH=./logs/app.log
LOG_PRETTY=true
LOG_COLORIZE=true

MONITORING_ENABLED=true
MONITORING_SERVICE_NAME=vubon-api
METRICS_ENABLED=true
METRICS_PATH=/metrics

TRACING_ENABLED=false
TRACING_SERVICE_NAME=vubon-api
TRACING_EXPORTER=otlp
TRACING_ENDPOINT=

ERROR_TRACKING_ENABLED=false
ERROR_TRACKING_PROVIDER=sentry
ERROR_TRACKING_DSN=


# ───────────────────────────────────────────────────────────────────────────
