# ═══════════════════════════════════════════════════════════════
# Order Service — Production Environment Template
# ═══════════════════════════════════════════════════════════════
# Usage: cp .env.production.example .env  (on production server)
# ═══════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3004
APP_NAME=order-service
APP_URL=https://orders.vubon.com.bd

# ─── DB (production uses Prisma) ───
DB_MODE=prisma
DATABASE_URL=postgresql://vubon:CHANGE_ME@postgres:5432/vubon_order
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=CHANGE_ME
DB_SSL=true
DB_LOGGING=false
PRISMA_SKIP_ENGINE_BOOTSTRAP=false

# ─── Redis ───
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=order:
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ─── Queue ───
QUEUE_AUTO_START_WORKERS=true

# ─── JWT (REQUIRED, min 32 chars) ───
JWT_SECRET=CHANGE_ME_JWT_SECRET_MUST_BE_AT_LEAST_32_CHARACTERS_LONG

# ─── Production values ───
LOG_LEVEL=info
AWS_REGION=ap-south-1
AWS_BUCKET=vubon-order-prod
SENDGRID_API_KEY=CHANGE_ME
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME
SENTRY_DSN=CHANGE_ME

# ─── External services ───
USER_SERVICE_URL=https://users.vubon.com.bd
PRODUCT_SERVICE_URL=https://products.vubon.com.bd
PAYMENT_SERVICE_URL=https://payments.vubon.com.bd
LOGISTICS_SERVICE_URL=https://logistics.vubon.com.bd
ANALYTICS_SERVICE_URL=https://analytics.vubon.com.bd
