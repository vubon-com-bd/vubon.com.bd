NODE_ENV=production
PORT=4004
LOG_LEVEL=info

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vubon_orders?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:6379
REDIS_DB=0

JWT_SECRET=<inject-from-secret-manager>
JWT_EXPIRES_IN=15m

ORDER_MAX_ITEMS=100
ORDER_MIN_AMOUNT=1
ORDER_MAX_AMOUNT=10000000
ORDER_ALLOW_GUEST=true

CHECKOUT_SESSION_TTL_SECONDS=3600
DELIVERY_MAX_ATTEMPTS=3
ORDER_CANCEL_WINDOW_HOURS=24
ORDER_RETURN_WINDOW_DAYS=7

PAYMENT_GATEWAY_URL=https://payments.vubon.com.bd
SHIPPING_PROVIDER_URL=https://shipping.vubon.com.bd
NOTIFICATION_SERVICE_URL=https://notify.vubon.com.bd
ANALYTICS_SERVICE_URL=https://analytics.vubon.com.bd

PAYMENT_GATEWAY_KEY=<inject-from-secret-manager>
SHIPPING_PROVIDER_KEY=<inject-from-secret-manager>
NOTIFICATION_API_KEY=<inject-from-secret-manager>
