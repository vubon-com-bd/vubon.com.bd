{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": false,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@domain/*": [
        "src/module/domain/*"
      ],
      "@domain/errors/*": [
        "src/module/domain/errors/*"
      ],
      "@domain/primitives/*": [
        "src/module/domain/value-objects/primitives/*"
      ],
      "@domain/composites/*": [
        "src/module/domain/value-objects/composites/*"
      ],
      "@domain/events/*": [
        "src/module/domain/events/*"
      ],
      "@domain/entities/*": [
        "src/module/domain/entities/*"
      ],
      "@domain/repositories/*": [
        "src/module/domain/repositories/*"
      ],
      "@domain/event-store/*": [
        "src/module/domain/event-store/*"
      ],
      "@domain/services/*": [
        "src/module/domain/services/*"
      ],
      "@domain/specifications/*": [
        "src/module/domain/specifications/*"
      ],
      "@application/*": [
        "src/module/application/*"
      ],
      "@application/errors/*": [
        "src/module/application/errors/*"
      ],
      "@application/dtos/*": [
        "src/module/application/dtos/*"
      ],
      "@application/dtos/requests/*": [
        "src/module/application/dtos/requests/*"
      ],
      "@application/dtos/responses/*": [
        "src/module/application/dtos/responses/*"
      ],
      "@application/services/*": [
        "src/module/application/services/*"
      ],
      "@application/services/interfaces/*": [
        "src/module/application/services/interfaces/*"
      ],
      "@application/services/impl/*": [
        "src/module/application/services/impl/*"
      ],
      "@application/commands/*": [
        "src/module/application/commands/*"
      ],
      "@application/queries/*": [
        "src/module/application/queries/*"
      ],
      "@application/sagas/*": [
        "src/module/application/sagas/*"
      ],
      "@application/mappers/*": [
        "src/module/application/mappers/*"
      ],
      "@application/validators/*": [
        "src/module/application/validators/*"
      ],
      "@infrastructure/*": [
        "src/module/infrastructure/*"
      ],
      "@infrastructure/prisma/*": [
        "src/module/infrastructure/persistence/prisma/*"
      ],
      "@infrastructure/cache/*": [
        "src/module/infrastructure/persistence/cache/*"
      ],
      "@infrastructure/persistence/*": [
        "src/module/infrastructure/persistence/*"
      ],
      "@infrastructure/mappers/*": [
        "src/module/infrastructure/persistence/prisma/mappers/*"
      ],
      "@infrastructure/repos/*": [
        "src/module/infrastructure/persistence/prisma/repositories/*"
      ],
      "@infrastructure/queues/*": [
        "src/module/infrastructure/queues/*"
      ],
      "@infrastructure/workers/*": [
        "src/module/infrastructure/workers/*"
      ],
      "@infrastructure/config/*": [
        "src/module/infrastructure/config/*"
      ],
      "@infrastructure/external/*": [
        "src/module/infrastructure/external/*"
      ],
      "@infrastructure/services/*": [
        "src/module/infrastructure/services/*"
      ],
      "@infrastructure/services/external/*": [
        "src/module/infrastructure/services/external/*"
      ],
      "@infrastructure/services/internal/*": [
        "src/module/infrastructure/services/internal/*"
      ],
      "@interfaces/*": [
        "src/module/interfaces/*"
      ],
      "@modules/*": [
        "src/module/modules/*"
      ]
    },
    "isolatedModules": true,
    "types": [
      "node",
      "jest"
    ],
    "ignoreDeprecations": "5.0",
    "strictPropertyInitialization": false,
    "rootDir": "./src",
    "useDefineForClassFields": false
  },
  "include": [
    "src/**/*",
    "prisma/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.e2e-spec.ts",
    "**/*.BAK.*",
    "**/*.bak",
    "**/modules.BAK*"
  ]
}
