# ═══════════════════════════════════════════════════════════════
# Order Service — Environment Variables
# ═══════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=4004
LOG_LEVEL=debug

DATABASE_URL=postgresql://vubon:vubon@localhost:5432/vubon_orders
REDIS_URL=redis://localhost:6379
REDIS_DB=0

JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=1h

ORDER_MAX_ITEMS=100
ORDER_MIN_AMOUNT=1
ORDER_MAX_AMOUNT=10000000
ORDER_PAYMENT_WINDOW_MINUTES=30
ORDER_CONFIRMATION_WINDOW_HOURS=24
ORDER_AUTO_CANCEL_HOURS=48
ORDER_ALLOW_GUEST=true
ORDER_MAX_NOTES_LENGTH=1000

ORDER_ITEM_MIN_QTY=1
ORDER_ITEM_MAX_QTY=999
ORDER_ITEM_MAX_PER_ORDER=100
ORDER_ITEM_MAX_NOTES=500
ORDER_ITEM_SKU_MAX=64

CHECKOUT_SESSION_TTL_SECONDS=3600
CHECKOUT_MAX_ATTEMPTS=3
CHECKOUT_RESERVE_STOCK_MINUTES=15
CHECKOUT_ALLOW_GUEST=true
CHECKOUT_REQUIRE_PHONE=true
CHECKOUT_REQUIRE_EMAIL=true
CHECKOUT_ALLOW_SHIPPING_BILLING_DIFF=true

DELIVERY_MAX_ATTEMPTS=3
DELIVERY_ATTEMPT_INTERVAL_HOURS=24
DELIVERY_GRACE_PERIOD_MINUTES=15
DELIVERY_RESCHEDULE_WINDOW_HOURS=48
DELIVERY_PROOF_REQUIRED=true
DELIVERY_SIGNATURE_REQUIRED=false
DELIVERY_CONTACTLESS=true

ORDER_CANCEL_WINDOW_HOURS=24
ORDER_CANCEL_ALLOW_AFTER_SHIPMENT=false
ORDER_CANCEL_AUTO_APPROVE=true
ORDER_CANCEL_REFUND_AUTO=true
ORDER_CANCEL_RESTOCK=true
ORDER_CANCEL_MAX_REASON_LENGTH=500

ORDER_RETURN_WINDOW_DAYS=7
ORDER_RETURN_MAX_DAYS=30
ORDER_RETURN_PICKUP_WINDOW_DAYS=3
ORDER_RETURN_INSPECTION_DAYS=2
ORDER_RETURN_REFUND_PROCESSING_DAYS=7
ORDER_RETURN_RESTOCK_FEE_PERCENT=0
ORDER_RETURN_FREE=true
ORDER_RETURN_MAX_IMAGES=5
ORDER_RETURN_MAX_REASON_LENGTH=1000

ORDER_FULFILLMENT_MAX_ITEMS_PER_SHIPMENT=50
ORDER_FULFILLMENT_AUTO=false
ORDER_FULFILLMENT_ALLOW_PARTIAL=true
ORDER_FULFILLMENT_NOTIFY=true
ORDER_FULFILLMENT_SLA_HOURS=48

ORDER_TRACKING_REFRESH_INTERVAL=300
ORDER_TRACKING_RETENTION_DAYS=365
ORDER_TRACKING_NOTIFY_ON_UPDATE=true
ORDER_TRACKING_LOCATION=true
ORDER_TRACKING_BY_PHONE=true

PAYMENT_GATEWAY_URL=https://payments.example.com
SHIPPING_PROVIDER_URL=https://shipping.example.com
NOTIFICATION_SERVICE_URL=https://notify.example.com
ANALYTICS_SERVICE_URL=https://analytics.example.com
