// ═══════════════════════════════════════════════════════════════
// Analytics Service — Prisma Schema (link to shared-kernel)
// ═══════════════════════════════════════════════════════════════
// NOTE: Single source of truth = packages/shared-kernel/prisma/schema.prisma
//       This file exists for Prisma tooling path resolution only.
//       Do NOT define models here.
//
// 20 analytics models live in shared-kernel:
//   AnalyticsEvent, AnalyticsEventPayload,
//   AnalyticsMetric, AnalyticsMetricAggregation,
//   AnalyticsDimension, AnalyticsDimensionValue,
//   AnalyticsKpi, AnalyticsKpiResult,
//   AnalyticsDashboard, AnalyticsWidget,
//   AnalyticsReport, AnalyticsReportFilter,
//   AnalyticsCohort, AnalyticsCohortAnalysis,
//   AnalyticsFunnel, AnalyticsFunnelAnalysis,
//   AnalyticsSession, AnalyticsPageView,
//   AnalyticsTrafficSource, AnalyticsAttribution

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
