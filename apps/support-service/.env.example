# ═══════════════════════════════════════════════════════════════════
# Support Service — Environment Template
# Copy: cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

NODE_ENV=development
LOG_LEVEL=debug
TZ=Asia/Dhaka
PORT=3007

APP_NAME=Vubon Support
APP_VERSION=1.0.0
APP_URL=http://localhost:3007
API_URL=http://localhost:3007/api

# Supabase — replace credentials
DATABASE_URL="postgresql://postgres.YOUR_PROJECT:[YOUR-PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT:[YOUR-PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres"

DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT_MS=5000

REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=support:

JWT_SECRET=your-256-bit-secret-min-32-chars-change-in-prod
JWT_ISSUER=vubon-api
JWT_AUDIENCE=vubon-client
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

USER_SERVICE_URL=http://localhost:3001
ORDER_SERVICE_URL=http://localhost:3002
PRODUCT_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005
VENDOR_SERVICE_URL=http://localhost:3006

FF_AI_RECOMMENDATION=true
FF_CHATBOT_ENABLED=true
FF_LIVE_CHAT_ENABLED=true
FF_SLA_ENABLED=true

EMAIL_ENABLED=true
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=noreply@vubon.com.bd
EMAIL_FROM_NAME=Vubon Support

SMS_ENABLED=false
SMS_PROVIDER=sslwireless
SMS_API_KEY=
SMS_SENDER_ID=Vubon

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_URL=http://localhost:3007/storage

WS_PORT=3007
WS_NAMESPACE=/support

QUEUE_REDIS_HOST=127.0.0.1
QUEUE_REDIS_PORT=6379
