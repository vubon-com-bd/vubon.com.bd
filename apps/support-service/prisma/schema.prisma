// support-service/prisma/schema.prisma
// Prisma schema — support-service (FULL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════ TICKET AGGREGATE ═══════════════════

model Ticket {
  id                  String    @id @default(uuid())
  number              String    @unique
  subject             String
  description         String
  status              String    @default("open")
  priority            String    @default("normal")
  type                String
  channel             String
  categoryId          String?
  userId              String
  assignedAgentId     String?
  orderId             String?
  productId           String?
  tags                String[]  @default([])
  attachments         String[]  @default([])
  firstResponseAt     DateTime?
  resolvedAt          DateTime?
  closedAt            DateTime?
  reopenedAt          DateTime?
  dueAt               DateTime?
  slaBreachedAt       DateTime?
  satisfactionRating  Int?
  satisfactionComment String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  @@index([userId])
  @@index([assignedAgentId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("tickets")
}

model TicketMessage {
  id           String   @id @default(uuid())
  ticketId     String
  content      String
  type         String
  status       String   @default("sent")
  authorUserId String?
  authorAgentId String?
  isInternal   Boolean  @default(false)
  attachments  String[] @default([])
  readAt       DateTime?
  editedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([ticketId])
  @@map("ticket_messages")
}

model TicketAttachment {
  id             String   @id @default(uuid())
  ticketId       String
  messageId      String?
  type           String
  url            String
  size           Int
  filename       String
  uploadedByUser String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ticketId])
  @@index([messageId])
  @@map("ticket_attachments")
}

model TicketEscalation {
  id           String    @id @default(uuid())
  ticketId     String
  level        String
  reason       String
  escalatedBy  String?
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([ticketId])
  @@map("ticket_escalations")
}

model TicketSatisfaction {
  id        String   @id @default(uuid())
  ticketId  String   @unique
  score     Int
  comment   String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ticket_satisfactions")
}

// ═══════════════════ CONVERSATION AGGREGATE ═══════════════════

model Conversation {
  id            String    @id @default(uuid())
  userId        String
  type          String
  status        String    @default("active")
  ticketId      String?
  assignedAgentId String?
  endedAt       DateTime?
  endedReason   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@map("conversations")
}

model SupportMessage {
  id             String    @id @default(uuid())
  conversationId String
  ticketId       String?
  senderKind     String
  senderUserId   String?
  senderAgentId  String?
  content        String
  type           String
  status         String    @default("sent")
  attachments    String[]  @default([])
  readAt         DateTime?
  editedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([conversationId])
  @@map("support_messages")
}

model SupportAttachment {
  id        String   @id @default(uuid())
  messageId String
  type      String
  url       String
  size      Int?
  filename  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([messageId])
  @@map("support_attachments")
}

// ═══════════════════ FAQ / KB ═══════════════════

model Faq {
  id           String   @id @default(uuid())
  question     String
  answer       String
  status       String   @default("draft")
  categoryId   String
  authorId     String
  viewCount    Int      @default(0)
  helpfulCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@map("faqs")
}

model FaqCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  parentId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("faq_categories")
}

model KnowledgeArticle {
  id           String   @id @default(uuid())
  title        String
  body         String
  status       String   @default("draft")
  categoryId   String
  authorId     String
  tags         String[] @default([])
  viewCount    Int      @default(0)
  helpfulCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@map("knowledge_articles")
}

model KnowledgeCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  parentId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("knowledge_categories")
}

// ═══════════════════ FEEDBACK / COMPLAINT ═══════════════════

model Feedback {
  id            String    @id @default(uuid())
  type          String
  status        String    @default("pending")
  content       String
  userId        String
  rating        Int?
  ticketId      String?
  orderId       String?
  reviewerId    String?
  reviewedAt    DateTime?
  reviewOutcome String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@map("feedbacks")
}

model Complaint {
  id           String    @id @default(uuid())
  type         String
  severity     String
  status       String    @default("pending")
  userId       String
  description  String
  orderId      String?
  vendorId     String?
  productId    String?
  resolverId   String?
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([severity])
  @@map("complaints")
}

// ═══════════════════ SURVEY ═══════════════════

model Survey {
  id            String    @id @default(uuid())
  type          String
  status        String    @default("draft")
  title         String
  questions     String[]  @default([])
  responseCount Int       @default(0)
  publishedAt   DateTime?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@map("surveys")
}

model SurveyResponse {
  id        String   @id @default(uuid())
  surveyId  String
  userId    String
  answers   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([surveyId, userId])
  @@index([surveyId])
  @@map("survey_responses")
}

// ═══════════════════ LIVE CHAT ═══════════════════

model LiveChat {
  id           String    @id @default(uuid())
  userId       String
  agentId      String?
  type         String
  status       String    @default("active")
  messageIds   String[]  @default([])
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  endedReason  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@map("live_chats")
}

// ═══════════════════ CHATBOT ═══════════════════

model Chatbot {
  id                  String   @id @default(uuid())
  type                String
  status              String   @default("active")
  name                String
  language            String   @default("en")
  confidenceThreshold Float    @default(0.7)
  intentIds           String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status])
  @@map("chatbots")
}

model ChatbotIntent {
  id        String   @id @default(uuid())
  name      String
  patterns  String[] @default([])
  response  String
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chatbot_intents")
}

model ChatbotSlot {
  id         String   @id @default(uuid())
  name       String
  entityType String
  required   Boolean  @default(false)
  enumValues String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("chatbot_slots")
}

// ═══════════════════ AGENT / TEAM ═══════════════════

model SupportAgent {
  id                    String    @id @default(uuid())
  userId                String    @unique
  type                  String
  status                String    @default("online")
  teamId                String?
  maxConcurrentTickets  Int       @default(5)
  currentTicketIds      String[]  @default([])
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
  @@index([teamId])
  @@map("support_agents")
}

model SupportTeam {
  id          String    @id @default(uuid())
  name        String
  type        String
  isActive    Boolean   @default(true)
  leadAgentId String?
  memberIds   String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type])
  @@map("support_teams")
}

// ═══════════════════ SLA / RULE / AUTOMATION / TEMPLATE ═══════════════════

model Sla {
  id             String    @id @default(uuid())
  ticketId       String
  type           String
  targetMinutes  Int
  status         String    @default("pending")
  priority       String
  startedAt      DateTime
  endedAt        DateTime?
  elapsedMinutes Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([ticketId])
  @@index([status])
  @@map("slas")
}

model SupportRule {
  id            String    @id @default(uuid())
  type          String
  condition     String
  action        String
  isActive      Boolean   @default(true)
  priority      Int       @default(0)
  triggerCount  Int       @default(0)
  lastTriggeredAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isActive])
  @@map("support_rules")
}

model SupportAutomation {
  id           String    @id @default(uuid())
  type         String
  status       String    @default("active")
  name         String
  schedule     String?
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  totalRuns    Int       @default(0)
  failureCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@map("support_automations")
}

model SupportTemplate {
  id          String   @id @default(uuid())
  type        String
  name        String
  content     String
  language    String   @default("en")
  isActive    Boolean  @default(true)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([isActive])
  @@map("support_templates")
}
