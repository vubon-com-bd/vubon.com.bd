# ═══════════════════════════════════════════════════════════════
# cart-service — Production Environment Template
# ═══════════════════════════════════════════════════════════════
# Copy to Railway dashboard variables. Do NOT commit real values.
#
# NOTE: Shared variables (DATABASE_URL, REDIS_URL, JWT_SECRET,
# Email/SMS/Push) are set at the ROOT level / Railway service group.
# This file lists cart-service-specific overrides.

# ─── Service identity ─────────────────────────────────────────
NODE_ENV=production
PORT=4003
APP_NAME=cart-service

# ─── Database (Railway PostgreSQL) ────────────────────────────
# Inherit from root; override only if cart needs separate DB.
# DATABASE_URL=${{Postgres.DATABASE_URL}}
DB_SSL=true
DB_LOGGING=false
DB_TIMEZONE=Asia/Dhaka
DB_SCHEMA=public

# ─── Redis (Railway Redis) ────────────────────────────────────
# Inherit from root.
# REDIS_URL=${{Redis.REDIS_URL}}
REDIS_KEY_PREFIX=vubon:
REDIS_DB=0
REDIS_TLS=false

# ─── Cart Config ──────────────────────────────────────────────
CART_DEFAULT_CURRENCY=BDT
CART_USER_TTL_HOURS=720
CART_GUEST_TTL_HOURS=168
CART_REDIS_TTL=604800
CART_CACHE_TTL=300
CART_MAX_ITEMS=100
CART_MAX_QTY_PER_ITEM=999

# ─── Abandonment ──────────────────────────────────────────────
ABANDONED_ENABLED=true
ABANDONED_THRESHOLD_HOURS=24
ABANDONED_MAX_REMINDERS=4
ABANDONED_DISCOUNT_PERCENT=10
ABANDONED_EXPIRY_DAYS=30

# ─── Reminders ────────────────────────────────────────────────
REMINDER_EMAIL_ENABLED=true
REMINDER_SMS_ENABLED=true
REMINDER_PUSH_ENABLED=true

# ─── External Services (production URLs) ──────────────────────
PRODUCT_SERVICE_URL=https://api.vubon.com.bd/products
USER_SERVICE_URL=https://api.vubon.com.bd/users
TAX_SERVICE_URL=https://api.vubon.com.bd/tax
SHIPPING_SERVICE_URL=https://api.vubon.com.bd/shipping
COUPON_SERVICE_URL=https://api.vubon.com.bd/coupons

# ─── Queue (BullMQ) ───────────────────────────────────────────
REDIS_QUEUE_DB=2
CART_QUEUE_CONCURRENCY=5

# ─── DO NOT SET IN PRODUCTION ─────────────────────────────────
# USE_IN_MEMORY_REPOS=true
