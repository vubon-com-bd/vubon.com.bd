NODE_ENV=production
PORT=3003
APP_NAME=cart-service
APP_URL=https://carts.vubon.com.bd

DB_MODE=prisma
DATABASE_URL=postgresql://vubon:CHANGE_ME@postgres:5432/vubon_cart
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=CHANGE_ME
DB_SSL=true

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=CHANGE_ME_REDIS

JWT_SECRET=CHANGE_ME_JWT_SECRET_MUST_BE_AT_LEAST_32_CHARS_LONG

LOG_LEVEL=info
PRODUCT_SERVICE_URL=https://products.vubon.com.bd
IDENTITY_SERVICE_URL=https://auth.vubon.com.bd
SENDGRID_API_KEY=CHANGE_ME
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME
