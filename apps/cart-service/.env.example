# ═══════════════════════════════════════════════════════════════
# cart-service — Local Development Environment
# ═══════════════════════════════════════════════════════════════
# Copy to .env and adjust.
#
# NOTE: Shared variables (DATABASE_URL, REDIS_URL, JWT_SECRET,
# Email/SMS/Push config, CORS) live in the ROOT .env.example.
# This file only lists cart-service-specific vars and local overrides.

# ─── Service identity ─────────────────────────────────────────
PORT=4003
APP_NAME=cart-service
APP_URL=http://localhost:4003
API_URL=http://localhost:4003/api

# ─── Database (Cart uses Prisma only for persistent entities) ──
# Cart primary store is Redis. Prisma holds:
#   • SavedItem, AbandonedCart, CartMerger
# DATABASE_URL default is inherited from root; override if needed.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vubon_cart?schema=public

# ─── Cart Config ──────────────────────────────────────────────
CART_DEFAULT_CURRENCY=BDT
CART_DEFAULT_TYPE=user
CART_USER_TTL_HOURS=720
CART_GUEST_TTL_HOURS=168
CART_REDIS_TTL=604800
CART_CACHE_TTL=300
CART_MAX_ITEMS=100
CART_MAX_QTY_PER_ITEM=999
CART_MIN_QTY_PER_ITEM=1
CART_MAX_COUPONS=1
CART_MAX_VOUCHERS=1
CART_MAX_SAVED_ITEMS=100
CART_EXPIRY_SCAN_INTERVAL_MS=3600000

# ─── Guest Cart ───────────────────────────────────────────────
GUEST_TOKEN_BYTES=32

# ─── Coupon ───────────────────────────────────────────────────
COUPON_CACHE_TTL=60

# ─── Abandonment ──────────────────────────────────────────────
ABANDONED_ENABLED=true
ABANDONED_THRESHOLD_HOURS=24
ABANDONED_MAX_REMINDERS=4
ABANDONED_DISCOUNT_PERCENT=10
ABANDONED_EXPIRY_DAYS=30
ABANDONED_TRACK_OPENS=true
ABANDONED_TRACK_CLICKS=true

# ─── Reminders ────────────────────────────────────────────────
REMINDER_EMAIL_ENABLED=true
REMINDER_SMS_ENABLED=false
REMINDER_PUSH_ENABLED=true
REMINDER_FIRST_HOURS=1
REMINDER_SECOND_HOURS=24
REMINDER_THIRD_HOURS=72
REMINDER_FINAL_HOURS=168

# ─── Queue (BullMQ) ───────────────────────────────────────────
REDIS_QUEUE_DB=2
REDIS_QUEUE_CONCURRENCY=5

# ─── External Services (cross-service calls) ──────────────────
PRODUCT_SERVICE_URL=http://localhost:4002/api/v1
USER_SERVICE_URL=http://localhost:4001/api/v1
TAX_SERVICE_URL=http://localhost:4004/api/v1
SHIPPING_SERVICE_URL=http://localhost:4005/api/v1
COUPON_SERVICE_URL=http://localhost:4006/api/v1

# ─── Dev/Test only (Termux Prisma workaround) ─────────────────
USE_IN_MEMORY_REPOS=false
