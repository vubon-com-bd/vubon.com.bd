# ═══════ Cart Service ═══════
PORT=3003
NODE_ENV=development

# Database (persistent only — saved/abandoned)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vubon_cart?schema=public

# Redis (primary cart storage)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cross-service APIs
PRODUCT_SERVICE_URL=http://localhost:3004
VENDOR_SERVICE_URL=http://localhost:3005
USER_SERVICE_URL=http://localhost:3001
MARKETING_SERVICE_URL=http://localhost:3006
LOGISTICS_SERVICE_URL=http://localhost:3007
TAX_SERVICE_URL=http://localhost:3008
