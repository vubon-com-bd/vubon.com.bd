# ═══════════════════════════════════════════════════════════════
# Cart Service — Environment Template
# ═══════════════════════════════════════════════════════════════
# Copy to .env:  cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ─── App ───
NODE_ENV=development
PORT=3003
APP_NAME=cart-service
APP_URL=http://localhost:3003

# ─── Database Mode ───
# memory = in-memory repos (no DB needed)
# prisma = Postgres + Redis (production)
DB_MODE=memory

# ─── Database (Prisma) ───
DATABASE_URL=postgresql://vubon:vubon@localhost:5432/vubon_cart
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vubon_cart
POSTGRES_USER=vubon
POSTGRES_PASSWORD=vubon
DB_DRIVER=postgres
DB_SSL=false
DB_LOGGING=false
DB_TIMEZONE=Asia/Dhaka

# ─── Redis ───
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=cart:
REDIS_DB=0
REDIS_PASSWORD=

# ─── Queue ───
QUEUE_DRIVER=bull
QUEUE_ENABLED=true
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_WORKER_CONCURRENCY=5
QUEUE_AUTO_START_WORKERS=true

# ─── JWT ───
JWT_SECRET=change_me_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=15m

# ─── Cart ───
CART_MAX_ITEMS=100
CART_DEFAULT_CURRENCY=BDT
CART_ALLOW_GUEST=true
CART_AUTO_MERGE=true
CART_EXPIRY_HOURS=720
CART_GUEST_EXPIRY_HOURS=168

# ─── Abandonment ───
ABANDONED_CART_ENABLED=true
ABANDONED_CART_THRESHOLD_HOURS=24
ABANDONED_CART_MAX_REMINDERS=4

# ─── External Services ───
PRODUCT_SERVICE_URL=http://localhost:3002
IDENTITY_SERVICE_URL=http://localhost:3001

# ─── Logging ───
LOG_LEVEL=debug
