{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@vubon/auth-shared-constants": ["../../packages/auth/shared-constants/src"],
      "@vubon/auth-shared-types": ["../../packages/auth/shared-types/src"],
      "@vubon/auth-shared-utils": ["../../packages/auth/shared-utils/src"],
      "@vubon/auth-shared-api": ["../../packages/auth/shared-api/src"],
      "@vubon/auth-shared-auth": ["../../packages/auth/shared-auth/src"],
      "@vubon/auth-shared-hooks": ["../../packages/auth/shared-hooks/src"],
      "@vubon/shared-ui": ["../../packages/shared-ui/src"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "dist", ".next"]
}
