{
  "name": "@vubon/notification-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc && tsc-alias -p tsconfig.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "generate:postman": "node scripts/generate-postman-collection.mjs",
    "generate:readme": "node scripts/generate-readme.mjs",
    "generate:docker": "node scripts/generate-docker.mjs",
    "test": "npm run test:all",
    "test:domain": "jest --config test/unit/jest.config.domain.ts",
    "test:domain:watch": "jest --config test/unit/jest.config.domain.ts --watch",
    "test:domain:cov": "jest --config test/unit/jest.config.domain.ts --coverage",
    "test:domain:ci": "jest --config test/unit/jest.config.domain.ts --coverage --ci --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "test:e2e:domain": "jest --config test/e2e/jest-e2e-domain.json --runInBand",
    "test:all": "jest --config test/unit/jest.config.ts",
    "test:application": "jest --config test/unit/jest.config.application.ts",
    "test:application:watch": "jest --config test/unit/jest.config.application.ts --watch",
    "test:application:cov": "jest --config test/unit/jest.config.application.ts --coverage",
    "test:application:ci": "jest --config test/unit/jest.config.application.ts --coverage --ci --runInBand",
    "test:e2e:application": "jest --config test/e2e/jest-e2e-application.json",
    "test:e2e:application:cov": "jest --config test/e2e/jest-e2e-application.json --coverage",
    "postman:generate": "node scripts/generate-postman-collection.mjs",
    "postman:test": "./scripts/run-newman.sh health",
    "postman:test:providers": "./scripts/run-newman.sh providers",
    "postman:test:notifications": "./scripts/run-newman.sh notifications",
    "postman:test:full": "./scripts/run-newman.sh full",
    "generate:all": "pnpm generate:docs && pnpm generate:postman && pnpm generate:inmemory",
    "generate:docs": "node scripts/generate-docs.mjs",
    "generate:inmemory": "node scripts/generate-inmemory-repos.mjs"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/cqrs": "^12.0.0",
    "@nestjs/graphql": "^14.0.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^5.10.0",
    "@vubon/shared-api": "workspace:*",
    "@vubon/shared-config": "workspace:*",
    "@vubon/shared-constants": "workspace:*",
    "@vubon/shared-kernel": "workspace:*",
    "@vubon/shared-schemas": "workspace:*",
    "@vubon/shared-types": "workspace:*",
    "@vubon/shared-utils": "workspace:*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "18.0.1",
    "graphql": "17.0.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@types/express": "^4.17.21",
    "@types/jest": "30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "prisma": "5.22.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.0",
    "tsc-alias": "^1.9.7",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  }
}
