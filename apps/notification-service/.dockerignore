.env
.env.local
.env.production
.env.*.local

# ─── Logs ─────────────────────────────────
*.log
logs
npm-debug.log*
pnpm-debug.log*

# ─── OS ───────────────────────────────────
.DS_Store
Thumbs.db

# ─── IDE ──────────────────────────────────
.vscode
.idea
*.swp
*.swo

# ─── Version control ──────────────────────
.git
.gitignore

