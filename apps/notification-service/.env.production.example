# ═══════════════════════════════════════════════════════════════
# Notification Service — Production Environment Template
# ═══════════════════════════════════════════════════════════════
# Usage: cp .env.production.example .env  (on production server)
# ═══════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3003
APP_NAME=notification-service
APP_URL=https://notification.vubon.com.bd
SERVICE_NAME=notification

# ─── DB (production uses Prisma) ───
DB_MODE=prisma
PERSISTENCE_DRIVER=prisma
DATABASE_URL=postgresql://vubon:CHANGE_ME@postgres:5432/vubon_notification
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vubon_notification
POSTGRES_USER=vubon
POSTGRES_PASSWORD=CHANGE_ME
DB_DRIVER=postgres
DB_SSL=true
DB_LOGGING=false
DB_TIMEZONE=Asia/Dhaka
DB_SCHEMA=public
DB_MAX_CONNECTIONS=100

# ─── Redis ───
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=notification:
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_TLS=false

# ─── Queue ───
QUEUE_DRIVER=bull
QUEUE_ENABLED=true
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_DEFAULT_BACKOFF_MS=5000
QUEUE_WORKER_CONCURRENCY=5
QUEUE_AUTO_START_WORKERS=true

# ─── JWT (REQUIRED, min 32 chars) ───
JWT_SECRET=CHANGE_ME_JWT_SECRET_MUST_BE_AT_LEAST_32_CHARACTERS_LONG
JWT_EXPIRES_IN=15m

# ─── Email Providers ───
EMAIL_ENABLED=true
EMAIL_PROVIDER=sendgrid
EMAIL_FROM_ADDRESS=noreply@vubon.com.bd
EMAIL_FROM_NAME=Vubon
SENDGRID_ENABLED=true
SENDGRID_API_KEY=CHANGE_ME_SENDGRID_API_KEY
SENDGRID_WEBHOOK_SECRET=CHANGE_ME
RESEND_ENABLED=false
RESEND_API_KEY=
SMTP_ENABLED=false

# ─── SMS Providers (Bangladesh) ───
SMS_ENABLED=true
SMS_PROVIDER=sslwireless
SMS_SENDER_ID=VUBON
SSLWIRELESS_ENABLED=true
SSLWIRELESS_API_KEY=CHANGE_ME_SSLWIRELESS_API_KEY
SSLWIRELESS_SENDER_ID=VUBON
BULKSMSBD_ENABLED=false
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ─── Push Providers ───
PUSH_ENABLED=true
PUSH_PROVIDER=fcm
FCM_ENABLED=true
FCM_PROJECT_ID=CHANGE_ME
FCM_CLIENT_EMAIL=CHANGE_ME
FCM_PRIVATE_KEY=CHANGE_ME
APNS_ENABLED=false
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.vubon.app
WEB_PUSH_ENABLED=false

# ─── Webhook ───
WEBHOOK_ENABLED=true
WEBHOOK_TIMEOUT_MS=30000
WEBHOOK_SIGNATURE_ALGORITHM=sha256

# ─── External Services ───
IDENTITY_SERVICE_URL=https://api.vubon.com.bd
IDENTITY_SERVICE_TIMEOUT=5000
ORDER_SERVICE_URL=https://api.vubon.com.bd
PRODUCT_SERVICE_URL=https://api.vubon.com.bd
VENDOR_SERVICE_URL=https://api.vubon.com.bd
PAYMENT_SERVICE_URL=https://api.vubon.com.bd
ANALYTICS_SERVICE_URL=https://api.vubon.com.bd
ANALYTICS_EVENTS_ENABLED=true

# ─── Feature Flags ───
NOTIFICATION_ENABLED=true
NOTIFY_EMAIL_ENABLED=true
NOTIFY_SMS_ENABLED=true
NOTIFY_PUSH_ENABLED=true
NOTIFY_IN_APP_ENABLED=true
NOTIFY_WEBHOOK_ENABLED=true

# ─── Logging ───
LOG_LEVEL=info

# ─── Monitoring (optional) ───
SENTRY_DSN=CHANGE_ME
