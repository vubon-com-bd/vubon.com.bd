NODE_ENV=production
PORT=4007
LOG_LEVEL=info

# ─── Database ───
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vubon_notifications?sslmode=require

# ─── Redis ───
REDIS_URL=rediss://default:PASSWORD@HOST:6379
REDIS_DB=0
REDIS_KEY_PREFIX=vubon:notify:

# ─── Auth ───
JWT_SECRET=<inject-from-secret-manager>
JWT_ISSUER=vubon-api
JWT_AUDIENCE=vubon-client

# ─── Notification master ───
NOTIFICATION_ENABLED=true
NOTIFY_EMAIL_ENABLED=true
NOTIFY_SMS_ENABLED=true
NOTIFY_PUSH_ENABLED=true
NOTIFY_IN_APP_ENABLED=true
NOTIFY_WEBHOOK_ENABLED=true

NOTIFY_RETRY_ATTEMPTS=3
NOTIFY_RETRY_DELAY_MS=60000
NOTIFY_BATCH_SIZE=500
NOTIFY_RATE_LIMIT_PER_SECOND=100
NOTIFY_QUEUE_ENABLED=true

# ─── Email — Resend (recommended primary) ───
RESEND_ENABLED=true
RESEND_API_KEY=<inject-from-secret-manager>
RESEND_FROM_EMAIL=noreply@vubon.com.bd
RESEND_FROM_NAME=Vubon
RESEND_WEBHOOK_SECRET=<inject-from-secret-manager>
RESEND_TIMEOUT_MS=15000
RESEND_MAX_RETRIES=3
EMAIL_ENABLED=true
EMAIL_PROVIDER=resend

# ─── Email — SMTP (fallback / dev) ───
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@vubon.com.bd
SMTP_PASSWORD=<inject-from-secret-manager>
SMTP_POOL=true
SMTP_MAX_CONNECTIONS=5
SMTP_TLS_STRICT=true
EMAIL_FROM_NAME=Vubon
EMAIL_FROM_ADDRESS=noreply@vubon.com.bd

# ─── SMS — Twilio (international) ───
TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=<inject-from-secret-manager>
TWILIO_AUTH_TOKEN=<inject-from-secret-manager>
TWILIO_MESSAGING_SERVICE_SID=<inject-from-secret-manager>
TWILIO_FROM_NUMBER=+15551234567
TWILIO_STATUS_CALLBACK=https://notify.vubon.com.bd/api/v1/provider-webhooks/twilio
TWILIO_TIMEOUT_MS=15000
TWILIO_MAX_RETRIES=3
SMS_ENABLED=true
SMS_PROVIDER=twilio

# ─── SMS — SSLWireless (Bangladesh) ───
SSLWIRELESS_ENABLED=false
SSLWIRELESS_API_KEY=<inject-from-secret-manager>
SSLWIRELESS_SENDER_ID=VUBON
SSLWIRELESS_BASE_URL=https://esms.mimsms.com

# ─── Push — FCM (Android + Web) ───
FCM_ENABLED=true
FCM_PROJECT_ID=<inject-from-secret-manager>
FCM_SERVICE_ACCOUNT_JSON=<inject-from-secret-manager>
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
FCM_TIMEOUT_MS=15000
FCM_MAX_RETRIES=3
PUSH_ENABLED=true
PUSH_PROVIDER=fcm

# ─── Push — Web Push (VAPID) ───
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC=<inject-from-secret-manager>
WEB_PUSH_VAPID_PRIVATE=<inject-from-secret-manager>
WEB_PUSH_SUBJECT=mailto:admin@vubon.com.bd

# ─── Queues ───
QUEUE_DRIVER=bull
QUEUE_ENABLED=true
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_WORKER_CONCURRENCY=5
QUEUE_AUTO_START_WORKERS=true

# ─── Cross-service URLs ───
USER_SERVICE_URL=https://api.vubon.com.bd/users
ORDER_SERVICE_URL=https://api.vubon.com.bd/orders
PRODUCT_SERVICE_URL=https://api.vubon.com.bd/products
VENDOR_SERVICE_URL=https://api.vubon.com.bd/vendors
PAYMENT_SERVICE_URL=https://api.vubon.com.bd/payments
ANALYTICS_SERVICE_URL=https://analytics.vubon.com.bd

ANALYTICS_API_KEY=<inject-from-secret-manager>

# ─── Observability ───
ENABLE_METRICS=true
