# notification-service — local development overrides
# Copy to .env.local and fill in real values
# NEVER commit .env.local to git

NODE_ENV=development
PORT=4007

# ─── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres@localhost:5432/vubon

# ─── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=vubon:notify:

# ─── JWT (dev only — never use these in prod) ─────────────────────
JWT_SECRET=dev-secret-at-least-32-chars-long-xxx
JWT_ISSUER=vubon-api
JWT_AUDIENCE=vubon-client

# ─── Channel toggles ──────────────────────────────────────────────
NOTIFICATION_ENABLED=true
NOTIFY_EMAIL_ENABLED=false
NOTIFY_SMS_ENABLED=false
NOTIFY_PUSH_ENABLED=false
NOTIFY_IN_APP_ENABLED=true
NOTIFY_WEBHOOK_ENABLED=false

# ─── Notification behaviour ───────────────────────────────────────
NOTIFY_RETRY_ATTEMPTS=3
NOTIFY_RETRY_DELAY_MS=60000
NOTIFY_BATCH_SIZE=500
NOTIFY_RATE_LIMIT_PER_SECOND=100
NOTIFY_QUEUE_ENABLED=true

# ─── Email — Resend (recommended for dev) ─────────────────────────
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Vubon Dev
RESEND_TIMEOUT_MS=15000
RESEND_MAX_RETRIES=3
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend

# ─── Email — SMTP (alternative) ───────────────────────────────────
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_POOL=true
SMTP_MAX_CONNECTIONS=5
SMTP_TLS_STRICT=true
EMAIL_FROM_NAME=Vubon Dev
EMAIL_FROM_ADDRESS=noreply@example.com

# ─── SMS — Twilio ─────────────────────────────────────────────────
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_STATUS_CALLBACK=
TWILIO_TIMEOUT_MS=15000
TWILIO_MAX_RETRIES=3
SMS_ENABLED=false
SMS_PROVIDER=twilio

# ─── SMS — SSLWireless (Bangladesh) ───────────────────────────────
SSLWIRELESS_ENABLED=false
SSLWIRELESS_API_KEY=
SSLWIRELESS_SENDER_ID=VUBON
SSLWIRELESS_BASE_URL=https://esms.mimsms.com

# ─── Push — FCM ───────────────────────────────────────────────────
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
FCM_SERVICE_ACCOUNT_JSON=
FCM_TIMEOUT_MS=15000
FCM_MAX_RETRIES=3
PUSH_ENABLED=false
PUSH_PROVIDER=fcm

# ─── Push — Web Push (VAPID) ──────────────────────────────────────
# Generate keys: npx web-push generate-vapid-keys
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC=
WEB_PUSH_VAPID_PRIVATE=
WEB_PUSH_SUBJECT=mailto:admin@example.com

# ─── Queue workers ────────────────────────────────────────────────
QUEUE_WORKER_CONCURRENCY=5
QUEUE_AUTOSTART_WORKERS=true

# ─── Cross-service URLs (optional for local) ──────────────────────
USER_SERVICE_URL=http://localhost:4001
ORDER_SERVICE_URL=http://localhost:4003
PRODUCT_SERVICE_URL=http://localhost:4002
VENDOR_SERVICE_URL=http://localhost:4005
PAYMENT_SERVICE_URL=http://localhost:4004

# ─── Observability ────────────────────────────────────────────────
LOG_LEVEL=debug
ENABLE_METRICS=false
