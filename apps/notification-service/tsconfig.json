{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@vubon/shared-kernel": ["../../packages/shared-kernel/src"],
      "@vubon/shared-kernel/*": ["../../packages/shared-kernel/src/*"],
      "@vubon/shared-constants": ["../../packages/shared-constants/src"],
      "@vubon/shared-constants/*": ["../../packages/shared-constants/src/*"],
      "@vubon/shared-types": ["../../packages/shared-types/src"],
      "@vubon/shared-types/*": ["../../packages/shared-types/src/*"],
      "@vubon/shared-schemas": ["../../packages/shared-schemas/src"],
      "@vubon/shared-schemas/*": ["../../packages/shared-schemas/src/*"],
      "@vubon/shared-utils": ["../../packages/shared-utils/src"],
      "@vubon/shared-utils/*": ["../../packages/shared-utils/src/*"],
      "@vubon/shared-config": ["../../packages/shared-config/src"],
      "@vubon/shared-config/*": ["../../packages/shared-config/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
