{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": false,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@domain/*": [
        "src/module/domain/*"
      ],
      "@domain/errors/*": [
        "src/module/domain/errors/*"
      ],
      "@domain/primitives/*": [
        "src/module/domain/value-objects/primitives/*"
      ],
      "@domain/composites/*": [
        "src/module/domain/value-objects/composites/*"
      ],
      "@domain/events/*": [
        "src/module/domain/events/*"
      ],
      "@domain/entities/*": [
        "src/module/domain/entities/*"
      ],
      "@domain/repositories/*": [
        "src/module/domain/repositories/*"
      ],
      "@domain/event-store/*": [
        "src/module/domain/event-store/*"
      ],
      "@domain/services/*": [
        "src/module/domain/services/*"
      ],
      "@domain/specifications/*": [
        "src/module/domain/specifications/*"
      ],
      "@application/*": [
        "src/module/application/*"
      ],
      "@application/errors/*": [
        "src/module/application/errors/*"
      ],
      "@application/dtos/*": [
        "src/module/application/dtos/*"
      ],
      "@application/dtos/requests/*": [
        "src/module/application/dtos/requests/*"
      ],
      "@application/dtos/responses/*": [
        "src/module/application/dtos/responses/*"
      ],
      "@application/services/*": [
        "src/module/application/services/*"
      ],
      "@application/services/interfaces/*": [
        "src/module/application/services/interfaces/*"
      ],
      "@application/services/impl/*": [
        "src/module/application/services/impl/*"
      ],
      "@application/commands/*": [
        "src/module/application/commands/*"
      ],
      "@application/queries/*": [
        "src/module/application/queries/*"
      ],
      "@application/sagas/*": [
        "src/module/application/sagas/*"
      ],
      "@application/mappers/*": [
        "src/module/application/mappers/*"
      ],
      "@application/validators/*": [
        "src/module/application/validators/*"
      ],
      "@infrastructure/*": [
        "src/module/infrastructure/*"
      ],
      "@infrastructure/prisma/*": [
        "src/module/infrastructure/persistence/prisma/*"
      ],
      "@infrastructure/cache/*": [
        "src/module/infrastructure/persistence/cache/*"
      ],
      "@infrastructure/persistence/*": [
        "src/module/infrastructure/persistence/*"
      ],
      "@infrastructure/mappers/*": [
        "src/module/infrastructure/persistence/prisma/mappers/*"
      ],
      "@infrastructure/repos/*": [
        "src/module/infrastructure/persistence/prisma/repositories/*"
      ],
      "@infrastructure/queues/*": [
        "src/module/infrastructure/queues/*"
      ],
      "@infrastructure/workers/*": [
        "src/module/infrastructure/workers/*"
      ],
      "@infrastructure/config/*": [
        "src/module/infrastructure/config/*"
      ],
      "@infrastructure/external/*": [
        "src/module/infrastructure/external/*"
      ],
      "@infrastructure/services/*": [
        "src/module/infrastructure/services/*"
      ],
      "@infrastructure/services/external/*": [
        "src/module/infrastructure/services/external/*"
      ],
      "@infrastructure/services/internal/*": [
        "src/module/infrastructure/services/internal/*"
      ],
      "@modules/common/*": [
        "src/module/modules/common/*"
      ],
      "@modules/health/*": [
        "src/module/modules/health/*"
      ],
      "@modules/notification/*": [
        "src/module/modules/notification/*"
      ],
      "@modules/notification-channel/*": [
        "src/module/modules/notification-channel/*"
      ],
      "@modules/notification-template/*": [
        "src/module/modules/notification-template/*"
      ],
      "@modules/notification-schedule/*": [
        "src/module/modules/notification-schedule/*"
      ],
      "@modules/notification-broadcast/*": [
        "src/module/modules/notification-broadcast/*"
      ],
      "@modules/notification-digest/*": [
        "src/module/modules/notification-digest/*"
      ],
      "@modules/notification-preference/*": [
        "src/module/modules/notification-preference/*"
      ],
      "@modules/notification-device/*": [
        "src/module/modules/notification-device/*"
      ],
      "@modules/notification-delivery/*": [
        "src/module/modules/notification-delivery/*"
      ],
      "@modules/notification-analytics/*": [
        "src/module/modules/notification-analytics/*"
      ],
      "@modules/webhook/*": [
        "src/module/modules/webhook/*"
      ],
      "@interfaces/*": [
        "src/module/interfaces/*"
      ],
      "@interfaces/controllers/*": [
        "src/module/interfaces/controllers/*"
      ],
      "@interfaces/controllers/rest/*": [
        "src/module/interfaces/controllers/rest/*"
      ],
      "@interfaces/controllers/webhooks/*": [
        "src/module/interfaces/controllers/webhooks/*"
      ],
      "@interfaces/controllers/graphql/*": [
        "src/module/interfaces/controllers/graphql/*"
      ],
      "@interfaces/dtos/*": [
        "src/module/interfaces/dtos/*"
      ],
      "@interfaces/dtos/requests/*": [
        "src/module/interfaces/dtos/requests/*"
      ],
      "@interfaces/dtos/responses/*": [
        "src/module/interfaces/dtos/responses/*"
      ],
      "@interfaces/guards/*": [
        "src/module/interfaces/guards/*"
      ],
      "@interfaces/interceptors/*": [
        "src/module/interfaces/interceptors/*"
      ],
      "@interfaces/decorators/*": [
        "src/module/interfaces/decorators/*"
      ],
      "@interfaces/mappers/*": [
        "src/module/interfaces/mappers/*"
      ],
      "@interfaces/validators/*": [
        "src/module/interfaces/validators/*"
      ],
      "@interfaces/middlewares/*": [
        "src/module/interfaces/middlewares/*"
      ],
      "@interfaces/swagger/*": [
        "src/module/interfaces/swagger/*"
      ],
      "@interfaces/errors/*": [
        "src/module/interfaces/errors/*"
      ],
      "@modules/*": [
        "src/module/modules/*"
      ],
      "@fixtures/*": [
        "test/fixtures/*"
      ],
      "@domain-fixtures/*": [
        "test/fixtures/domain/*"
      ],
      "@domain": [
        "src/module/domain/index.ts"
      ]
    },
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "ignoreDeprecations": "5.0",
    "strictPropertyInitialization": false,
    "rootDir": "./src",
    "useDefineForClassFields": false
  },
  "include": [
    "src/**/*",
    "prisma/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.e2e-spec.ts",
    "**/*.BAK.*",
    "**/*.bak",
    "**/modules.BAK*"
  ]
}
