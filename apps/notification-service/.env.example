# ═══════════════════════════════════════════════════════════════
# Notification Service — Environment Template
# ═══════════════════════════════════════════════════════════════
# Copy to .env: cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ─── App ───
NODE_ENV=development
PORT=3003
APP_NAME=notification-service
APP_URL=http://localhost:3003

# ─── Database ───
DATABASE_URL=postgresql://u0_a350@localhost:5432/vubon_notification
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT_MS=5000

# ─── Prisma engine ───
# Set to true on Termux ARM64 (Prisma native engine incompatible)
PRISMA_SKIP_ENGINE_BOOTSTRAP=true

# ─── Redis ───
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=vubon:notification:
REDIS_DB=0

# ─── JWT ───
JWT_ISSUER=vubon-api
JWT_AUDIENCE=vubon-client
DISABLE_AUTH=false

# ─── CORS ───
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3003

# ─── Email Providers ───
EMAIL_ENABLED=true
EMAIL_PROVIDER_ORDER=sendgrid,mailgun,resend,ses,smtp,postmark
EMAIL_FROM_NAME=Vubon
EMAIL_FROM_ADDRESS=noreply@vubon.com.bd

SENDGRID_ENABLED=false
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_SECRET=

MAILGUN_ENABLED=false
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_WEBHOOK_SECRET=

SES_ENABLED=false
SES_REGION=ap-south-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

RESEND_ENABLED=false
RESEND_API_KEY=

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── SMS Providers (Bangladesh) ───
SMS_ENABLED=true
SMS_PROVIDER_ORDER=sslwireless,bulksmsbd,mimsms,twilio
SMS_SENDER_ID=VUBON

SSLWIRELESS_ENABLED=false
SSLWIRELESS_API_KEY=

BULKSMSBD_ENABLED=false
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=VUBON

MIMSMS_ENABLED=false
MIMSMS_API_KEY=

TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

BANGLALINK_ENABLED=false
BANGLALINK_API_KEY=

GRAMEENPHONE_ENABLED=false
GRAMEENPHONE_API_KEY=

ROBI_ENABLED=false
ROBI_API_KEY=

AIRTEL_ENABLED=false
AIRTEL_API_KEY=

TELETALK_ENABLED=false
TELETALK_API_KEY=

# ─── Push Providers ───
PUSH_ENABLED=true
PUSH_PROVIDER_ORDER=fcm,apns,onesignal,web-push,expo

FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

APNS_ENABLED=false
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC=
WEB_PUSH_VAPID_PRIVATE=

ONESIGNAL_ENABLED=false
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

EXPO_PUSH_ENABLED=false

# ─── Webhook ───
WEBHOOK_ENABLED=true
WEBHOOK_TIMEOUT_MS=30000
WEBHOOK_MAX_RETRIES=5
WEBHOOK_SIGNATURE_ALGORITHM=sha256

SLACK_WEBHOOK_URL=

# ─── In-App ───
IN_APP_WEBSOCKET_ENABLED=true
IN_APP_SSE_ENABLED=true

# ─── Queue ───
QUEUE_DRIVER=bull
QUEUE_REDIS_URL=redis://localhost:6379

# ─── Service endpoints (cross-service HTTP clients) ───
IDENTITY_SERVICE_URL=http://localhost:3001
ORDER_SERVICE_URL=http://localhost:3002
PRODUCT_SERVICE_URL=http://localhost:3004
VENDOR_SERVICE_URL=http://localhost:3005
PAYMENT_SERVICE_URL=http://localhost:3006
ANALYTICS_SERVICE_URL=http://localhost:3007

# ─── Unsubscribe link ───
UNSUBSCRIBE_BASE_URL=http://localhost:3000/unsubscribe

SERVICE_NAME=notification
