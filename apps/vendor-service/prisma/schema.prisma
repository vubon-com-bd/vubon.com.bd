// ═══════════════════════════════════════════════════════════════
// Vendor Service — Prisma Schema (link to shared-kernel)
// ═══════════════════════════════════════════════════════════════
// NOTE: Single source of truth = packages/shared-kernel/prisma/schema.prisma
//       This file exists for Prisma tooling path resolution only.
//       Do NOT define models here.
//
// 23 vendor models live in shared-kernel:
//   Vendor, VendorProfile, VendorSettings, VendorDocument, VendorVerification,
//   VendorApproval, VendorSuspension, VendorSuspensionLog, VendorTeamMember,
//   VendorTeamInvite, VendorPayout, VendorSettlement, VendorInvoice,
//   VendorSubscription, VendorCommission, VendorRating, VendorReview,
//   VendorPerformance, VendorStats, VendorReport, VendorShipping,
//   VendorWarranty, VendorReturnPolicy

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
