# ═══════════════════════════════════════════════════════════════
# Vendor Service — Production Environment Template
# ═══════════════════════════════════════════════════════════════
# Usage: cp .env.production.example .env  (on production server)
# ═══════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3004
APP_NAME=vendor-service
APP_URL=https://vendors.vubon.com.bd

# ─── DB (production uses Prisma) ───
DB_MODE=prisma
DATABASE_URL=postgresql://vubon:CHANGE_ME@postgres:5432/vubon_vendors
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=CHANGE_ME
DB_SSL=true
DB_LOGGING=false

# ─── Redis ───
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ─── JWT (REQUIRED, min 32 chars) ───
JWT_SECRET=CHANGE_ME_JWT_SECRET_MUST_BE_AT_LEAST_32_CHARACTERS_LONG

# ─── Production values ───
LOG_LEVEL=info
AUTH_SERVICE_URL=https://auth.vubon.com.bd
USER_SERVICE_URL=https://users.vubon.com.bd
PRODUCT_SERVICE_URL=https://products.vubon.com.bd
VENDOR_SERVICE_URL=https://vendors.vubon.com.bd
NOTIFICATION_SERVICE_URL=https://notifications.vubon.com.bd
ANALYTICS_SERVICE_URL=https://analytics.vubon.com.bd
ORDER_SERVICE_URL=https://orders.vubon.com.bd

AWS_REGION=ap-south-1
AWS_BUCKET=vubon-vendor-prod
SENDGRID_API_KEY=CHANGE_ME
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME
SENTRY_DSN=CHANGE_ME
