# ═══════════════════════════════════════════════════════════════
# Vendor Service — Production Environment (example)
# ═══════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=4006
LOG_LEVEL=info

DATABASE_URL=postgresql://USER:PASS@HOST:5432/vubon_vendors?schema=public&connection_limit=10
REDIS_URL=redis://default:PASSWORD@HOST:6379
REDIS_DB=0

JWT_SECRET=REPLACE-WITH-STRONG-SECRET-MIN-32-CHARS
JWT_EXPIRES_IN=1h

# ─── Vendor core ───
VENDOR_ENABLED=true
VENDOR_DEFAULT_CURRENCY=BDT
VENDOR_AUTO_APPROVE_THRESHOLD=90
VENDOR_REVIEW_SLA_HOURS=48

# ─── Payout ───
VENDOR_PAYOUT_MIN_AMOUNT=100
VENDOR_PAYOUT_MAX_AMOUNT=10000000
VENDOR_PAYOUT_HOLD_DAYS=7
VENDOR_PAYOUT_AUTO=false
VENDOR_PAYOUT_REQUIRE_APPROVAL=true

# ─── External services ───
STORAGE_BASE_URL=https://cdn.vubon.com
NOTIFICATION_SERVICE_URL=https://notify.vubon.com
ANALYTICS_SERVICE_URL=https://analytics.vubon.com
BANK_VERIFIER_URL=https://kyc.vubon.com

# ─── Queues ───
QUEUE_ENABLED=true
QUEUE_AUTO_START_WORKERS=true
QUEUE_WORKER_CONCURRENCY=10
