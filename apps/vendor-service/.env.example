# ═══════════════════════════════════════════════════════════════
# Vendor Service — Environment Template
# ═══════════════════════════════════════════════════════════════
# Copy to .env: cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ─── App ───
NODE_ENV=development
PORT=3004
APP_NAME=vendor-service
APP_URL=http://localhost:3004

# ─── Database Mode ───
DB_MODE=memory                      # memory | prisma

# ─── Database (Prisma) ───
DATABASE_URL=postgresql://u0_a350@localhost:5432/vubon_vendors?schema=public
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vubon_vendors
POSTGRES_USER=u0_a350
POSTGRES_PASSWORD=
DB_DRIVER=postgres
DB_SSL=false
DB_LOGGING=false
DB_TIMEZONE=Asia/Dhaka
DB_SCHEMA=public
DB_MAX_CONNECTIONS=100

# ─── Prisma Engine (Termux-safe) ───
PRISMA_SKIP_ENGINE_BOOTSTRAP=false

# ─── Redis ───
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=vendor:
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_MAX_RETRIES=3
REDIS_LAZY_CONNECT=false

# ─── Queue ───
QUEUE_DRIVER=bull
QUEUE_ENABLED=true
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_DEFAULT_BACKOFF_MS=5000
QUEUE_WORKER_CONCURRENCY=5
QUEUE_AUTO_START_WORKERS=true

# ─── JWT ───
JWT_SECRET=change_me_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# ─── Cross-Service URLs ───
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
PRODUCT_SERVICE_URL=http://localhost:3003
VENDOR_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005
ANALYTICS_SERVICE_URL=http://localhost:3006
ORDER_SERVICE_URL=http://localhost:3007

# ─── AWS S3 (optional) ───
AWS_REGION=us-east-1
AWS_BUCKET=vubon-vendor
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Email / Slack (optional) ───
EMAIL_FROM=vendor@vubon.com.bd
SENDGRID_API_KEY=
SLACK_WEBHOOK_URL=

# ─── Logging ───
LOG_LEVEL=debug
