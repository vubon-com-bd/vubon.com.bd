# ═══════════════════════════════════════════════════════════════
# Vendor Service — Environment Variables
# ═══════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=4006
LOG_LEVEL=debug

DATABASE_URL=postgresql://vubon:vubon@localhost:5432/vubon_vendors
REDIS_URL=redis://localhost:6379
REDIS_DB=0

JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=1h

# ─── Vendor core ───
VENDOR_ENABLED=true
VENDOR_DEFAULT_CURRENCY=BDT
VENDOR_AUTO_APPROVE_THRESHOLD=90
VENDOR_REVIEW_SLA_HOURS=48
VENDOR_MAX_RESUBMISSIONS=3
VENDOR_APPEAL_WINDOW_DAYS=30

# ─── Suspension ───
VENDOR_SUSPENSION_DEFAULT_DAYS=30
VENDOR_SUSPENSION_MAX_DAYS=365
VENDOR_SUSPENSION_APPEAL_WINDOW_DAYS=14
VENDOR_AUTO_LIFT_ON_RESOLUTION=true

# ─── Commission ───
VENDOR_COMMISSION_DEFAULT_PERCENT=15
VENDOR_COMMISSION_MIN_PERCENT=1
VENDOR_COMMISSION_MAX_PERCENT=50

# ─── Payout ───
VENDOR_PAYOUT_MIN_AMOUNT=100
VENDOR_PAYOUT_MAX_AMOUNT=10000000
VENDOR_PAYOUT_HOLD_DAYS=7
VENDOR_PAYOUT_PROCESSING_DAYS=3
VENDOR_PAYOUT_AUTO=false
VENDOR_PAYOUT_REQUIRE_APPROVAL=true
VENDOR_PAYOUT_MAX_PER_DAY=1

# ─── Settlement ───
VENDOR_SETTLEMENT_MIN_AMOUNT=1000
VENDOR_SETTLEMENT_MAX_AMOUNT=1000000
VENDOR_SETTLEMENT_DEFAULT_CYCLE=weekly
VENDOR_SETTLEMENT_HOLD_PERIOD_DAYS=7

# ─── Subscription ───
VENDOR_SUBSCRIPTION_TRIAL_DAYS=14
VENDOR_SUBSCRIPTION_GRACE_PERIOD_DAYS=7
VENDOR_SUBSCRIPTION_AUTO_RENEW=true

# ─── Team ───
VENDOR_TEAM_MAX_MEMBERS=50
VENDOR_TEAM_INVITE_EXPIRY_DAYS=7
VENDOR_TEAM_MAX_INVITES_PER_DAY=10

# ─── Document ───
VENDOR_DOCUMENT_MAX_SIZE_MB=10
VENDOR_DOCUMENT_MAX_DOCUMENTS=20
VENDOR_DOCUMENT_EXPIRY_REMINDER_DAYS=30

# ─── Verification ───
VENDOR_VERIFICATION_REVIEW_SLA_HOURS=72
VENDOR_VERIFICATION_EXPIRY_DAYS=365
VENDOR_VERIFICATION_AUTO_APPROVE=false

# ─── Performance ───
VENDOR_PERFORMANCE_EVALUATION_PERIOD_DAYS=30
VENDOR_PERFORMANCE_MIN_ORDERS=10
VENDOR_PERFORMANCE_AUTO_SUSPEND_BELOW=40
VENDOR_PERFORMANCE_WARNING_BELOW=60

# ─── Rating ───
VENDOR_RATING_MIN_REVIEWS_FOR_DISPLAY=5
VENDOR_RATING_AUTO_HIDE_BELOW=2
VENDOR_RATING_AUTO_FLAG_BELOW=3

# ─── Report ───
VENDOR_REPORT_MAX_DATE_RANGE_DAYS=365
VENDOR_REPORT_MAX_ROWS=100000
VENDOR_REPORT_EXPORT_EXPIRY_HOURS=24

# ─── External services ───
STORAGE_BASE_URL=https://storage.vubon.local
NOTIFICATION_SERVICE_URL=https://notify.example.com
ANALYTICS_SERVICE_URL=https://analytics.example.com
BANK_VERIFIER_URL=https://bank-verifier.example.com

# ─── Queues ───
QUEUE_DRIVER=bull
QUEUE_ENABLED=true
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_DEFAULT_BACKOFF_MS=5000
QUEUE_WORKER_CONCURRENCY=5
QUEUE_AUTO_START_WORKERS=true
