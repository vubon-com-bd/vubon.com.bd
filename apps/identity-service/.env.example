NODE_ENV=development
APP_NAME=identity-service
APP_VERSION=1.0.0
APP_URL=http://localhost:3001
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

DB_MODE=memory
DATABASE_URL=postgresql://user@localhost:5432/vubon
PRISMA_SKIP_ENGINE_BOOTSTRAP=true

REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=vubon:identity:

JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=900
AUTH_REQUIRE_EMAIL_VERIFY=true

SESSION_EXPIRY_SECONDS=86400
SESSION_IDLE_TIMEOUT=1800
SESSION_MAX_PER_USER=5

MFA_TOTP_PERIOD=30
MFA_TOTP_DIGITS=6
MFA_OTP_EXPIRY=300

OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5

KYC_MAX_DOCUMENTS=10
KYC_REVIEW_SLA_HOURS=48

EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@vubon.com.bd

LOG_LEVEL=info
DEBUG=false

# ─── Social OAuth2 Providers ──────────────────────────

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# Facebook OAuth2
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3001/api/v1/auth/facebook/callback

# Apple Sign In
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/apple/callback

# GitHub OAuth2
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/api/v1/auth/github/callback

# LinkedIn OAuth2
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/v1/auth/linkedin/callback

# Twitter (X) OAuth2
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:3001/api/v1/auth/social/twitter/callback

# Microsoft (Azure AD) OAuth2
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3001/api/v1/auth/social/microsoft/callback
