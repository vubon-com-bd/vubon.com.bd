# App
NODE_ENV=development
PORT=3001
SERVICE_NAME=auth-service
API_PREFIX=api/v1

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/auth_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-me
JWT_REFRESH_EXPIRES_IN=7d

# Session
SESSION_TTL_MS=86400000

# MFA
MFA_ISSUER=Vubon
MFA_SECRET_MIN_LENGTH=32
MFA_RECOVERY_CODE_LENGTH=10

# Security
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MS=900000

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vubon.com

# SMS
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_API_SECRET=

# Push
PUSH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Rate Limit
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
