NODE_ENV=development
APP_NAME=identity-service
APP_VERSION=1.0.0
APP_URL=http://localhost:3001
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

DB_MODE=memory
DATABASE_URL=postgresql://user@localhost:5432/vubon
PRISMA_SKIP_ENGINE_BOOTSTRAP=true

REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=vubon:identity:

JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=900
AUTH_REQUIRE_EMAIL_VERIFY=true

SESSION_EXPIRY_SECONDS=86400
SESSION_IDLE_TIMEOUT=1800
SESSION_MAX_PER_USER=5

MFA_TOTP_PERIOD=30
MFA_TOTP_DIGITS=6
MFA_OTP_EXPIRY=300

OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5

KYC_MAX_DOCUMENTS=10
KYC_REVIEW_SLA_HOURS=48

EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@vubon.com.bd

LOG_LEVEL=info
DEBUG=false
