# ═══════════════════════════════════════════════════════════════
# identity-service — Environment Template (Development)
# ═══════════════════════════════════════════════════════════════
# Copy to .env and fill real values. Do NOT commit .env.

# ─── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
SERVICE_NAME=identity-service
APP_NAME=identity-service
API_PREFIX=api/v1

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/identity_db?schema=public
DB_SSL=false
DB_LOGGING=false
DB_TIMEZONE=Asia/Dhaka
DB_SCHEMA=public

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=vubon:
REDIS_TLS=false
REDIS_QUEUE_DB=2

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-me
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-me
JWT_ISSUER=vubon-api
JWT_AUDIENCE=vubon-client
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Password / Bcrypt ────────────────────────────────────────
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# ─── Session ──────────────────────────────────────────────────
SESSION_TTL_MS=86400000
SESSION_EXPIRY_SECONDS=86400
SESSION_REMEMBER_EXPIRY=2592000
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=604800
SESSION_REFRESH_THRESHOLD=300
SESSION_MAX_PER_USER=5
SESSION_MAX_DEVICES=10
SESSION_CLEANUP_INTERVAL=3600

# ─── Registration / Login ─────────────────────────────────────
AUTH_REGISTRATION_OPEN=true
AUTH_REQUIRE_EMAIL_VERIFY=true
AUTH_REQUIRE_PHONE_VERIFY=false
AUTH_ALLOW_CONCURRENT=true
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=900

# ─── MFA ──────────────────────────────────────────────────────
MFA_ISSUER=Vubon
MFA_TOTP_WINDOW=1
MFA_TOTP_PERIOD=30
MFA_TOTP_DIGITS=6
MFA_BACKUP_CODE_COUNT=10
MFA_OTP_EXPIRY=300
MFA_MAX_ATTEMPTS=5
MFA_SECRET_MIN_LENGTH=32
MFA_RECOVERY_CODE_LENGTH=10

# ─── Account Lock ─────────────────────────────────────────────
ACCOUNT_LOCK_MAX_ATTEMPTS=5
ACCOUNT_LOCK_BASE_DURATION=900
ACCOUNT_LOCK_AUTO_CHECK_INTERVAL=300

# ─── Device ───────────────────────────────────────────────────
DEVICE_TRUST_THRESHOLD=3
DEVICE_MAX_PER_USER=10
DEVICE_AUTO_TRUST=true
DEVICE_REQUIRE_TRUST_ADMIN=true
DEVICE_FINGERPRINT_TTL_DAYS=365

# ─── Biometric ────────────────────────────────────────────────
BIOMETRIC_ENABLED=true
BIOMETRIC_MAX_ENROLLMENTS=3
BIOMETRIC_REQUIRE_PASSWORD=true
BIOMETRIC_DEVICE_BIND=true

# ─── OAuth / Social / SSO ─────────────────────────────────────
SOCIAL_LOGIN_ENABLED=true
SOCIAL_ALLOW_LINK_EXISTING=true
SOCIAL_ALLOW_AUTO_REGISTER=true
SSO_ENABLED=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Email ────────────────────────────────────────────────────
EMAIL_ENABLED=true
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=noreply@vubon.com.bd
EMAIL_FROM_NAME=Vubon

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@vubon.com

# ─── SMS ──────────────────────────────────────────────────────
SMS_ENABLED=false
SMS_PROVIDER=sslwireless
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=Vubon

# ─── Push ─────────────────────────────────────────────────────
PUSH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Queue ────────────────────────────────────────────────────
QUEUE_DRIVER=bull
QUEUE_ENABLED=true
QUEUE_WORKER_CONCURRENCY=5

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
