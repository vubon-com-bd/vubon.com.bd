# ═══════════════════════════════════════════════════════════════════
# AUTH-SERVICE — LOCAL OVERRIDES
# ═══════════════════════════════════════════════════════════════════
# এই ফাইলটি root .env-কে OVERRIDE করে।
# Root .env-এ যা আছে তার সব এখানে থাকা লাগবে না।

# ─── Service Port (auth-service runs on 3001) ─────────────────────
PORT=3001
APP_NAME=identity-service
APP_URL=http://localhost:3001

# ─── Auth-specific ────────────────────────────────────────────────
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=900
AUTH_REGISTRATION_OPEN=true
AUTH_REQUIRE_EMAIL_VERIFY=true
AUTH_REQUIRE_PHONE_VERIFY=false
AUTH_ALLOW_CONCURRENT=true

# ─── Password ─────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# ─── MFA ──────────────────────────────────────────────────────────
MFA_ISSUER=Vubon
MFA_TOTP_WINDOW=1
MFA_TOTP_PERIOD=30
MFA_TOTP_DIGITS=6
MFA_BACKUP_CODE_COUNT=10
MFA_OTP_EXPIRY=300
MFA_MAX_ATTEMPTS=5

# ─── Session ──────────────────────────────────────────────────────
SESSION_EXPIRY_SECONDS=86400
SESSION_REMEMBER_EXPIRY=2592000
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=604800
SESSION_REFRESH_THRESHOLD=300
SESSION_MAX_PER_USER=5
SESSION_MAX_DEVICES=10
SESSION_CLEANUP_INTERVAL=3600

# ─── Account Lock ─────────────────────────────────────────────────
ACCOUNT_LOCK_MAX_ATTEMPTS=5
ACCOUNT_LOCK_BASE_DURATION=900
ACCOUNT_LOCK_AUTO_CHECK_INTERVAL=300

# ─── Login Attempt ────────────────────────────────────────────────
LOGIN_ATTEMPT_WINDOW=900
LOGIN_ATTEMPT_IP_THRESHOLD=20
LOGIN_ATTEMPT_EMAIL_THRESHOLD=5
LOGIN_ATTEMPT_RETENTION_DAYS=90

# ─── Device ───────────────────────────────────────────────────────
DEVICE_TRUST_THRESHOLD=3
DEVICE_MAX_PER_USER=10
DEVICE_AUTO_TRUST=true
DEVICE_REQUIRE_TRUST_ADMIN=true
DEVICE_FINGERPRINT_TTL_DAYS=365

# ─── Social ───────────────────────────────────────────────────────
SOCIAL_LOGIN_ENABLED=true
SOCIAL_ALLOW_LINK_EXISTING=true
SOCIAL_ALLOW_AUTO_REGISTER=true

# ─── OAuth (uncomment + fill as needed) ───────────────────────────
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_REDIRECT_URI=http://localhost:3001/auth/oauth/google/callback

# ─── SSO ──────────────────────────────────────────────────────────
SSO_ENABLED=false

# ─── 2FA ──────────────────────────────────────────────────────────
2FA_DEFAULT_METHOD=totp
2FA_REQUIRED_ADMIN=true
2FA_REQUIRED_VENDOR=false
2FA_BACKUP_COUNT=10
2FA_CHALLENGE_EXPIRY=300
2FA_REMEMBER_DEVICE=true
2FA_REMEMBER_DEVICE_TTL_DAYS=30

# ─── Biometric ────────────────────────────────────────────────────
BIOMETRIC_ENABLED=true
BIOMETRIC_MAX_ENROLLMENTS=3
BIOMETRIC_REQUIRE_PASSWORD=true
BIOMETRIC_DEVICE_BIND=true

# ─── User ─────────────────────────────────────────────────────────
USER_NAME_MIN_LENGTH=2
USER_NAME_MAX_LENGTH=100
USER_USERNAME_MIN_LENGTH=3
USER_USERNAME_MAX_LENGTH=30
USER_MAX_ADDRESSES=10
USER_MAX_CONTACTS=5
USER_REQUIRE_UNIQUE_PHONE=true
USER_SOFT_DELETE=true

# ─── Queue (BullMQ) ───────────────────────────────────────────────
REDIS_QUEUE_DB=2
REDIS_QUEUE_CONCURRENCY=5
DATABASE_URL="postgresql://u0_a350@localhost:5432/vubon_auth?schema=public"
USE_IN_MEMORY_REPOS=true

# ─── Runtime — Auth Service ─────────────────────
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-secret-change-in-production-min-32-chars-please-1234
JWT_ISSUER=vubon-api
JWT_AUDIENCE=vubon-client
JWT_ALGORITHM=HS256
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
PRISMA_SKIP_ENGINE_BOOTSTRAP=false
