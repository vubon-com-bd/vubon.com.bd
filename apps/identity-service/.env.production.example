# ═══════════════════════════════════════════════════════════════
# auth-service — Production Environment Template
# ═══════════════════════════════════════════════════════════════
# Copy to Railway dashboard variables. Do NOT commit real values.

# ─── Runtime ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
APP_NAME=auth-service

# ─── Database (Railway PostgreSQL) ────────────────────────────
# Reference the Postgres plugin:
DATABASE_URL=${{Postgres.DATABASE_URL}}
DB_SSL=true
DB_LOGGING=false
DB_TIMEZONE=Asia/Dhaka
DB_SCHEMA=public

# ─── Redis (Railway Redis) ────────────────────────────────────
REDIS_URL=${{Redis.REDIS_URL}}
REDIS_KEY_PREFIX=vubon:
REDIS_DB=0
REDIS_TLS=false
REDIS_QUEUE_DB=2

# ─── JWT ──────────────────────────────────────────────────────
# 48+ random chars. Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_STRONG_48_PLUS_CHAR_SECRET
JWT_ISSUER=vubon-api
JWT_AUDIENCE=vubon-client
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Password / Bcrypt ────────────────────────────────────────
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# ─── Session ──────────────────────────────────────────────────
SESSION_EXPIRY_SECONDS=86400
SESSION_REMEMBER_EXPIRY=2592000
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=604800
SESSION_REFRESH_THRESHOLD=300
SESSION_MAX_PER_USER=5
SESSION_MAX_DEVICES=10
SESSION_CLEANUP_INTERVAL=3600

# ─── Login attempts ───────────────────────────────────────────
LOGIN_ATTEMPT_WINDOW=900
LOGIN_ATTEMPT_IP_THRESHOLD=20
LOGIN_ATTEMPT_EMAIL_THRESHOLD=5
LOGIN_ATTEMPT_RETENTION_DAYS=90

# ─── Account lock ─────────────────────────────────────────────
ACCOUNT_LOCK_MAX_ATTEMPTS=5
ACCOUNT_LOCK_BASE_DURATION=900
ACCOUNT_LOCK_AUTO_CHECK_INTERVAL=300

# ─── MFA ──────────────────────────────────────────────────────
MFA_ISSUER=Vubon
MFA_TOTP_WINDOW=1
MFA_TOTP_PERIOD=30
MFA_TOTP_DIGITS=6
MFA_BACKUP_CODE_COUNT=10
MFA_OTP_EXPIRY=300
MFA_MAX_ATTEMPTS=5

# ─── 2FA ──────────────────────────────────────────────────────
2FA_DEFAULT_METHOD=totp
2FA_REQUIRED_ADMIN=true
2FA_REQUIRED_VENDOR=false
2FA_BACKUP_COUNT=10
2FA_CHALLENGE_EXPIRY=300
2FA_REMEMBER_DEVICE=true
2FA_REMEMBER_DEVICE_TTL_DAYS=30

# ─── Device ───────────────────────────────────────────────────
DEVICE_TRUST_THRESHOLD=3
DEVICE_MAX_PER_USER=10
DEVICE_AUTO_TRUST=true
DEVICE_REQUIRE_TRUST_ADMIN=true
DEVICE_FINGERPRINT_TTL_DAYS=365

# ─── Verification ─────────────────────────────────────────────
AUTH_REQUIRE_EMAIL_VERIFY=true
AUTH_REQUIRE_PHONE_VERIFY=false
AUTH_VERIFICATION_CODE_LENGTH=6
AUTH_VERIFICATION_EXPIRY=600

# ─── Registration ─────────────────────────────────────────────
AUTH_REGISTRATION_OPEN=true
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=900
AUTH_ALLOW_CONCURRENT=true

# ─── Biometric ────────────────────────────────────────────────
BIOMETRIC_ENABLED=true
BIOMETRIC_MAX_ENROLLMENTS=3
BIOMETRIC_REQUIRE_PASSWORD=true
BIOMETRIC_DEVICE_BIND=true

# ─── Social ───────────────────────────────────────────────────
SOCIAL_LOGIN_ENABLED=true
SOCIAL_ALLOW_LINK_EXISTING=true
SOCIAL_ALLOW_AUTO_REGISTER=true

# ─── OAuth providers (uncomment + fill as needed) ────────────
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_REDIRECT_URI=https://auth.vubon.com.bd/auth/oauth/google/callback
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_FACEBOOK_CLIENT_ID=
# OAUTH_FACEBOOK_CLIENT_SECRET=

# ─── SSO ──────────────────────────────────────────────────────
SSO_ENABLED=false

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=https://your-frontend.com

# ─── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Queue ────────────────────────────────────────────────────
QUEUE_DRIVER=bull
QUEUE_ENABLED=true
QUEUE_WORKER_CONCURRENCY=5

# ─── Email (shared SMTP) ──────────────────────────────────────
EMAIL_ENABLED=true
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=noreply@vubon.com.bd
EMAIL_SMTP_PASSWORD=REPLACE_WITH_SMTP_APP_PASSWORD
EMAIL_FROM=noreply@vubon.com.bd
EMAIL_FROM_NAME=Vubon

# ─── SMS ──────────────────────────────────────────────────────
SMS_ENABLED=false
SMS_PROVIDER=sslwireless
SMS_API_KEY=
SMS_SENDER_ID=Vubon
