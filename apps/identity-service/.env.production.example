# ═══════════════════════════════════════════════════════════════
# IDENTITY SERVICE — PRODUCTION CONFIGURATION
# ═══════════════════════════════════════════════════════════════

NODE_ENV=production
APP_NAME=identity-service
APP_URL=https://identity.vubon.com.bd
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=https://vubon.com.bd,https://www.vubon.com.bd

# ⚠️ Production এ Prisma DB use করব
DB_MODE=prisma
DATABASE_URL=postgresql://vubon_user:STRONG_PASSWORD@db.vubon.com.bd:5432/vubon?sslmode=require&schema=public
DB_SSL=true
DB_LOGGING=false

# ⚠️ Redis with password + TLS
REDIS_URL=rediss://:STRONG_REDIS_PASSWORD@redis.vubon.com.bd:6380
REDIS_TLS=true
REDIS_PASSWORD=STRONG_REDIS_PASSWORD

# ⚠️ Strong secrets (min 64 chars)
JWT_SECRET=CHANGE_ME_TO_STRONG_64_CHAR_SECRET_...
JWT_REFRESH_SECRET=CHANGE_ME_TO_STRONG_64_CHAR_SECRET_...
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Security
BCRYPT_ROUNDS=14
PASSWORD_MIN_LENGTH=12
PASSWORD_EXPIRY_DAYS=90
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=strict

# ⚠️ Real providers
EMAIL_ENABLED=true
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.xxx
EMAIL_FROM=noreply@vubon.com.bd

SMS_ENABLED=true
SMS_PROVIDER=sslwireless
SSLWIRELESS_API_KEY=xxx

STORAGE_ENABLED=true
STORAGE_PROVIDER=s3
AWS_REGION=ap-southeast-1
AWS_BUCKET=vubon-identity-prod
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=xxx

CDN_ENABLED=true
CDN_BASE_URL=https://cdn.vubon.com.bd

# Observability
LOG_LEVEL=warn
MONITORING_ENABLED=true
TRACING_ENABLED=true
ERROR_TRACKING_ENABLED=true
ERROR_TRACKING_DSN=https://xxx@sentry.io/xxx

# Cross-service (production URLs)
USER_SERVICE_URL=https://user.vubon.com.bd
NOTIFICATION_SERVICE_URL=https://notification.vubon.com.bd
