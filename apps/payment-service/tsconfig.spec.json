{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": false,
    "types": [
      "node",
      "jest"
    ],
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@domain/*": [
        "src/module/domain/*"
      ],
      "@domain/errors/*": [
        "src/module/domain/errors/*"
      ],
      "@domain/primitives/*": [
        "src/module/domain/value-objects/primitives/*"
      ],
      "@domain/composites/*": [
        "src/module/domain/value-objects/composites/*"
      ],
      "@domain/events/*": [
        "src/module/domain/events/*"
      ],
      "@domain/entities/*": [
        "src/module/domain/entities/*"
      ],
      "@domain/repositories/*": [
        "src/module/domain/repositories/*"
      ],
      "@domain/event-store/*": [
        "src/module/domain/event-store/*"
      ],
      "@domain/services/*": [
        "src/module/domain/services/*"
      ],
      "@domain/specifications/*": [
        "src/module/domain/specifications/*"
      ],
      "@application/*": [
        "src/module/application/*"
      ],
      "@application/errors/*": [
        "src/module/application/errors/*"
      ],
      "@application/dtos/*": [
        "src/module/application/dtos/*"
      ],
      "@application/services/*": [
        "src/module/application/services/*"
      ],
      "@application/services/interfaces/*": [
        "src/module/application/services/interfaces/*"
      ],
      "@application/services/impl/*": [
        "src/module/application/services/impl/*"
      ],
      "@application/commands/*": [
        "src/module/application/commands/*"
      ],
      "@application/queries/*": [
        "src/module/application/queries/*"
      ],
      "@application/sagas/*": [
        "src/module/application/sagas/*"
      ],
      "@application/mappers/*": [
        "src/module/application/mappers/*"
      ],
      "@application/validators/*": [
        "src/module/application/validators/*"
      ],
      "@fixtures/*": [
        "test/fixtures/*"
      ],
      "@app-fixtures/*": [
        "test/fixtures/application/*"
      ],
      "@interfaces/*": [
        "src/module/interfaces/*"
      ],
      "@interfaces/controllers/*": [
        "src/module/interfaces/controllers/*"
      ],
      "@interfaces/controllers/rest/*": [
        "src/module/interfaces/controllers/rest/*"
      ],
      "@interfaces/controllers/webhooks/*": [
        "src/module/interfaces/controllers/webhooks/*"
      ],
      "@interfaces/controllers/graphql/*": [
        "src/module/interfaces/controllers/graphql/*"
      ],
      "@interfaces/dtos/*": [
        "src/module/interfaces/dtos/*"
      ],
      "@interfaces/dtos/requests/*": [
        "src/module/interfaces/dtos/requests/*"
      ],
      "@interfaces/dtos/responses/*": [
        "src/module/interfaces/dtos/responses/*"
      ],
      "@interfaces/guards/*": [
        "src/module/interfaces/guards/*"
      ],
      "@interfaces/interceptors/*": [
        "src/module/interfaces/interceptors/*"
      ],
      "@interfaces/decorators/*": [
        "src/module/interfaces/decorators/*"
      ],
      "@interfaces/mappers/*": [
        "src/module/interfaces/mappers/*"
      ],
      "@interfaces/validators/*": [
        "src/module/interfaces/validators/*"
      ],
      "@interfaces/middlewares/*": [
        "src/module/interfaces/middlewares/*"
      ],
      "@interfaces/swagger/*": [
        "src/module/interfaces/swagger/*"
      ],
      "@interfaces/errors/*": [
        "src/module/interfaces/errors/*"
      ],
      "@infra-fixtures/*": [
        "test/fixtures/infrastructure/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*"
  ]
}