# ═══════════════════════════════════════════════════════════════
# Payment Service — Environment Template
# ═══════════════════════════════════════════════════════════════
# Copy to .env: cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ─── App ───
NODE_ENV=development
PORT=3006
APP_NAME=payment-service
APP_URL=http://localhost:3006

# ─── Database Mode ───
# memory → InMemory repositories (dev/test, no DB needed)
# prisma → Prisma repositories (production, DB backed)
DB_MODE=memory

# ─── Database (Prisma) ───
DATABASE_URL=postgresql://u0_a350@localhost:5432/vubon_payment
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vubon_payment
DB_DRIVER=postgres
DB_SSL=false
DB_LOGGING=false
DB_TIMEZONE=Asia/Dhaka
DB_SCHEMA=public
DB_MAX_CONNECTIONS=100

# ─── Prisma engine ───
# Set to true on Termux ARM64 (Prisma native engine incompatible)
PRISMA_SKIP_ENGINE_BOOTSTRAP=true

# ─── Redis ───
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=payment:
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_MAX_RETRIES=3
REDIS_LAZY_CONNECT=false

# ─── Queue ───
QUEUE_DRIVER=bull
QUEUE_ENABLED=true
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_DEFAULT_BACKOFF_MS=5000
QUEUE_WORKER_CONCURRENCY=5
QUEUE_AUTO_START_WORKERS=false

# ─── JWT (must match identity-service) ───
JWT_SECRET=change_me_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=15m

# ─── AWS S3 (optional — invoices/reports) ───
AWS_REGION=us-east-1
AWS_BUCKET=vubon-order
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Email / Slack (optional) ───
EMAIL_FROM=order@vubon.com.bd
SENDGRID_API_KEY=
SLACK_WEBHOOK_URL=

# ─── External Services ───
USER_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3005
LOGISTICS_SERVICE_URL=http://localhost:3006
ANALYTICS_SERVICE_URL=http://localhost:3010

# ─── Logging ───
LOG_LEVEL=debug

# ═══════════════════════════════════════════════════════════════
# PAYMENT GATEWAYS
# ═══════════════════════════════════════════════════════════════

# ─── bKash ───
BKASH_ENABLED=false
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_CALLBACK_URL=
BKASH_TIMEOUT_MS=30000
BKASH_TOKEN_TTL_SECONDS=3300
BKASH_INTENT=sale

# ─── Nagad ───
NAGAD_ENABLED=false
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PG_PUBLIC_KEY=
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080
NAGAD_CALLBACK_URL=
NAGAD_TIMEOUT_MS=30000

# ─── Rocket (DBBL) ───
ROCKET_ENABLED=false
ROCKET_MERCHANT_ID=
ROCKET_API_KEY=
ROCKET_BASE_URL=
ROCKET_CALLBACK_URL=
ROCKET_TIMEOUT_MS=30000

# ─── Stripe ───
STRIPE_ENABLED=false
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-10-28.acacia
STRIPE_TIMEOUT_MS=30000
STRIPE_MAX_RETRIES=3
STRIPE_CAPTURE_METHOD=automatic

# ─── PayPal ───
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_TIMEOUT_MS=30000
PAYPAL_BRAND_NAME=Vubon
PAYPAL_LANDING_PAGE=LOGIN

# ─── SSLCommerz ───
SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_SUCCESS_URL=
SSLCOMMERZ_FAIL_URL=
SSLCOMMERZ_CANCEL_URL=
SSLCOMMERZ_IPN_URL=
SSLCOMMERZ_TIMEOUT_MS=30000

# ─── aamarPay ───
AAMARPAY_ENABLED=false
AAMARPAY_STORE_ID=
AAMARPAY_SIGNATURE_KEY=
AAMARPAY_BASE_URL=https://sandbox.aamarpay.com
AAMARPAY_SUCCESS_URL=
AAMARPAY_FAIL_URL=
AAMARPAY_CANCEL_URL=
AAMARPAY_IPN_URL=
AAMARPAY_TIMEOUT_MS=30000

# ─── Gateway Routing ───
PAYMENT_ACTIVE_GATEWAY=bkash
PAYMENT_GATEWAY_ENV=sandbox
PAYMENT_GATEWAY_TIMEOUT_MS=30000
PAYMENT_GATEWAY_RETRIES=3
PAYMENT_GATEWAY_RETRY_DELAY_MS=5000
PAYMENT_WEBHOOK_VERIFY=true
PAYMENT_3DS_ENABLED=true

# ═══════════════════════════════════════════════════════════════
# PAYMENT BUSINESS RULES
# ═══════════════════════════════════════════════════════════════

# ─── Payment Core ───
PAYMENT_ENABLED=true
PAYMENT_CURRENCY=BDT
PAYMENT_MIN_AMOUNT=1
PAYMENT_MAX_AMOUNT=10000000
PAYMENT_CAPTURE_MODE=auto
PAYMENT_SESSION_TTL=1800
PAYMENT_AUTH_TTL=604800
PAYMENT_CAPTURE_WINDOW_HOURS=168
PAYMENT_IDEMPOTENCY=true
PAYMENT_IDEMPOTENCY_TTL=86400
PAYMENT_PARTIAL_CAPTURE=true

# ─── Refund ───
REFUND_ENABLED=true
REFUND_WINDOW_DAYS=90
REFUND_PARTIAL_ALLOWED=true
REFUND_AUTO_APPROVE=false
REFUND_AUTO_APPROVE_THRESHOLD=1000
REFUND_REQUIRE_REASON=true
REFUND_NOTIFY_CUSTOMER=true
REFUND_PROCESS_DAYS=7

# ─── Recurring / Subscription ───
RECURRING_ENABLED=false
RECURRING_MAX_ACTIVE=10
RECURRING_GRACE_DAYS=3
RECURRING_RETRY_ATTEMPTS=3
RECURRING_RETRY_INTERVAL_DAYS=2
RECURRING_CANCEL_AT_PERIOD_END=true
RECURRING_AUTO_RENEW=true
SUBSCRIPTION_MAX_TRIAL_DAYS=30

# ─── Invoice ───
INVOICE_ENABLED=true
INVOICE_PREFIX=INV
INVOICE_DUE_DAYS=15
INVOICE_OVERDUE_GRACE_DAYS=3
INVOICE_EMAIL_ENABLED=true
INVOICE_ATTACHMENT_ENABLED=true
INVOICE_AUTO_SEND=false
INVOICE_NUMBER_SEQUENCE=6

# ─── Fees ───
FEE_VAT_BPS=1500
FEE_STRIPE_BPS=250
FEE_BKASH_BPS=180
FEE_NAGAD_BPS=150
FEE_SSLCOMMERZ_BPS=230
FEE_PAYPAL_BPS=340
FEE_DEFAULT_BPS=250
FEE_COD_FLAT=20

# ─── Retry / Circuit Breaker ───
RETRY_MAX_ATTEMPTS=3
RETRY_DELAY_MS=200
RETRY_BACKOFF_FACTOR=2
RETRY_MAX_DELAY_MS=5000
RETRY_CB_THRESHOLD=5
RETRY_CB_OPEN_MS=30000

# ─── Webhook ───
WEBHOOK_SIGNATURE_VERIFY=true
WEBHOOK_RETRY_MAX_ATTEMPTS=5
WEBHOOK_RETRY_DELAY_MS=30000
WEBHOOK_TOLERANCE_SECONDS=300
WEBHOOK_RETENTION_DAYS=30
WEBHOOK_IDEMPOTENCY_HOURS=24

# ─── External Services ───
ORDER_SERVICE_URL=http://localhost:3004
USER_SERVICE_URL=http://localhost:3003
VENDOR_SERVICE_URL=http://localhost:3005

# ─── Crypto (optional) ───
CRYPTO_ENABLED=false
CRYPTO_RPC_URL=
CRYPTO_USDT_CONTRACT=
CRYPTO_BTC_NETWORK=testnet
CRYPTO_CONFIRMATION_BLOCKS=3
CRYPTO_TIMEOUT_MS=60000

# QR Code HMAC Signing
QR_HMAC_SECRET=a3f333b2e6401a112898eada0fd61bb7755d8d8227fadac2c7f90eb13b755720
QR_CODE_EXPIRY_HOURS=168
