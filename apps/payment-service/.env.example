# ═══════════════════════════════════════════════════════════════
# Payment Service — Environment Variables
# ═══════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=4005
LOG_LEVEL=debug

DATABASE_URL=postgresql://vubon:vubon@localhost:5432/vubon_payments
REDIS_URL=redis://localhost:6379
REDIS_DB=0

JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=1h

# ─── Payment core ───
PAYMENT_ENABLED=true
PAYMENT_CURRENCY=BDT
PAYMENT_MIN_AMOUNT=1
PAYMENT_MAX_AMOUNT=10000000
PAYMENT_CAPTURE_MODE=auto
PAYMENT_SESSION_TTL=1800
PAYMENT_AUTH_TTL=604800
PAYMENT_CAPTURE_WINDOW_HOURS=168
PAYMENT_IDEMPOTENCY=true
PAYMENT_IDEMPOTENCY_TTL=86400
PAYMENT_PARTIAL_CAPTURE=true

# ─── Gateway router ───
PAYMENT_ACTIVE_GATEWAY=bkash
PAYMENT_GATEWAY_ENV=sandbox
PAYMENT_GATEWAY_TIMEOUT_MS=30000
PAYMENT_GATEWAY_RETRIES=3
PAYMENT_GATEWAY_RETRY_DELAY_MS=5000
PAYMENT_WEBHOOK_VERIFY=true
PAYMENT_3DS_ENABLED=true

# ─── Refund ───
REFUND_ENABLED=true
REFUND_WINDOW_DAYS=90
REFUND_PARTIAL_ALLOWED=true
REFUND_AUTO_APPROVE=false
REFUND_AUTO_APPROVE_THRESHOLD=1000
REFUND_REQUIRE_REASON=true
REFUND_NOTIFY_CUSTOMER=true
REFUND_PROCESS_DAYS=7

# ─── bKash ───
BKASH_ENABLED=false
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_CALLBACK_URL=
BKASH_TIMEOUT_MS=30000

# ─── Nagad ───
NAGAD_ENABLED=false
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PG_PUBLIC_KEY=
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080
NAGAD_CALLBACK_URL=
NAGAD_TIMEOUT_MS=30000

# ─── Rocket (DBBL) ───
ROCKET_ENABLED=false
ROCKET_MERCHANT_ID=
ROCKET_API_KEY=
ROCKET_BASE_URL=
ROCKET_CALLBACK_URL=
ROCKET_TIMEOUT_MS=30000

# ─── SSLCommerz ───
SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_SUCCESS_URL=
SSLCOMMERZ_FAIL_URL=
SSLCOMMERZ_CANCEL_URL=
SSLCOMMERZ_TIMEOUT_MS=30000

# ─── Stripe ───
STRIPE_ENABLED=false
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-10-28.acacia
STRIPE_TIMEOUT_MS=30000
STRIPE_MAX_RETRIES=3
STRIPE_CAPTURE_METHOD=automatic

# ─── PayPal ───
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_TIMEOUT_MS=30000
PAYPAL_BRAND_NAME=Vubon
PAYPAL_LANDING_PAGE=LOGIN

# ─── aamarPay ───
AAMARPAY_ENABLED=false
AAMARPAY_STORE_ID=
AAMARPAY_SIGNATURE_KEY=
AAMARPAY_BASE_URL=https://sandbox.aamarpay.com
AAMARPAY_SUCCESS_URL=
AAMARPAY_FAIL_URL=
AAMARPAY_CANCEL_URL=
AAMARPAY_TIMEOUT_MS=30000

# ─── Recurring / Installment ───
RECURRING_ENABLED=false
RECURRING_MAX_ACTIVE=10
RECURRING_GRACE_DAYS=3
RECURRING_RETRY_ATTEMPTS=3
RECURRING_RETRY_INTERVAL_DAYS=2
RECURRING_CANCEL_AT_PERIOD_END=true
RECURRING_AUTO_RENEW=true

INSTALLMENT_ENABLED=false
INSTALLMENT_MIN_AMOUNT=1000
INSTALLMENT_MAX_AMOUNT=1000000
INSTALLMENT_MIN_TENURE=3
INSTALLMENT_MAX_TENURE=24
INSTALLMENT_DEFAULT_TENURE=6
INSTALLMENT_INTEREST_RATE=0
INSTALLMENT_REQUIRE_APPROVAL=true
INSTALLMENT_FEE_PERCENT=2

# ─── Queues ───
QUEUE_DRIVER=bull
QUEUE_ENABLED=true
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_DEFAULT_BACKOFF_MS=5000
QUEUE_WORKER_CONCURRENCY=5
QUEUE_AUTO_START_WORKERS=true

# ─── Webhook retry ───
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_JITTER_MS=1000
WEBHOOK_SIGNATURE_ALGORITHM=sha256
WEBHOOK_SIGNATURE_TOLERANCE=300

# ─── External services ───
NOTIFICATION_SERVICE_URL=https://notify.example.com
ANALYTICS_SERVICE_URL=https://analytics.example.com
