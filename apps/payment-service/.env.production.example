NODE_ENV=production
PORT=4005
LOG_LEVEL=info

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vubon_payments?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:6379
REDIS_DB=0

JWT_SECRET=<inject-from-secret-manager>
JWT_EXPIRES_IN=15m

# ─── Payment core ───
PAYMENT_ENABLED=true
PAYMENT_CURRENCY=BDT
PAYMENT_MIN_AMOUNT=1
PAYMENT_MAX_AMOUNT=10000000
PAYMENT_CAPTURE_MODE=auto
PAYMENT_CAPTURE_WINDOW_HOURS=168
PAYMENT_IDEMPOTENCY=true
PAYMENT_IDEMPOTENCY_TTL=86400
PAYMENT_PARTIAL_CAPTURE=true

# ─── Gateway router ───
PAYMENT_ACTIVE_GATEWAY=bkash
PAYMENT_GATEWAY_ENV=production
PAYMENT_GATEWAY_TIMEOUT_MS=30000
PAYMENT_GATEWAY_RETRIES=3
PAYMENT_WEBHOOK_VERIFY=true
PAYMENT_3DS_ENABLED=true

# ─── Refund ───
REFUND_ENABLED=true
REFUND_WINDOW_DAYS=90
REFUND_PARTIAL_ALLOWED=true
REFUND_AUTO_APPROVE=false
REFUND_AUTO_APPROVE_THRESHOLD=1000
REFUND_REQUIRE_REASON=true
REFUND_PROCESS_DAYS=7

# ─── bKash ───
BKASH_ENABLED=true
BKASH_APP_KEY=<inject-from-secret-manager>
BKASH_APP_SECRET=<inject-from-secret-manager>
BKASH_USERNAME=<inject-from-secret-manager>
BKASH_PASSWORD=<inject-from-secret-manager>
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_CALLBACK_URL=https://payments.vubon.com.bd/api/v1/webhooks/bkash
BKASH_TIMEOUT_MS=30000

# ─── Nagad ───
NAGAD_ENABLED=true
NAGAD_MERCHANT_ID=<inject-from-secret-manager>
NAGAD_MERCHANT_PRIVATE_KEY=<inject-from-secret-manager>
NAGAD_PG_PUBLIC_KEY=<inject-from-secret-manager>
NAGAD_BASE_URL=https://api.mynagad.com
NAGAD_CALLBACK_URL=https://payments.vubon.com.bd/api/v1/webhooks/nagad
NAGAD_TIMEOUT_MS=30000

# ─── Rocket ───
ROCKET_ENABLED=true
ROCKET_MERCHANT_ID=<inject-from-secret-manager>
ROCKET_API_KEY=<inject-from-secret-manager>
ROCKET_BASE_URL=https://api.rocket.com.bd
ROCKET_CALLBACK_URL=https://payments.vubon.com.bd/api/v1/webhooks/rocket
ROCKET_TIMEOUT_MS=30000

# ─── SSLCommerz ───
SSLCOMMERZ_ENABLED=true
SSLCOMMERZ_STORE_ID=<inject-from-secret-manager>
SSLCOMMERZ_STORE_PASSWORD=<inject-from-secret-manager>
SSLCOMMERZ_BASE_URL=https://securepay.sslcommerz.com
SSLCOMMERZ_SUCCESS_URL=https://shop.vubon.com.bd/checkout/success
SSLCOMMERZ_FAIL_URL=https://shop.vubon.com.bd/checkout/fail
SSLCOMMERZ_CANCEL_URL=https://shop.vubon.com.bd/checkout/cancel
SSLCOMMERZ_TIMEOUT_MS=30000

# ─── Stripe ───
STRIPE_ENABLED=true
STRIPE_PUBLISHABLE_KEY=<inject-from-secret-manager>
STRIPE_SECRET_KEY=<inject-from-secret-manager>
STRIPE_WEBHOOK_SECRET=<inject-from-secret-manager>
STRIPE_API_VERSION=2024-10-28.acacia
STRIPE_TIMEOUT_MS=30000
STRIPE_MAX_RETRIES=3
STRIPE_CAPTURE_METHOD=automatic

# ─── PayPal ───
PAYPAL_ENABLED=true
PAYPAL_CLIENT_ID=<inject-from-secret-manager>
PAYPAL_CLIENT_SECRET=<inject-from-secret-manager>
PAYPAL_WEBHOOK_ID=<inject-from-secret-manager>
PAYPAL_BASE_URL=https://api-m.paypal.com
PAYPAL_TIMEOUT_MS=30000
PAYPAL_BRAND_NAME=Vubon
PAYPAL_LANDING_PAGE=LOGIN

# ─── Queues ───
QUEUE_DRIVER=bull
QUEUE_ENABLED=true
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_WORKER_CONCURRENCY=5
QUEUE_AUTO_START_WORKERS=true

# ─── External services ───
NOTIFICATION_SERVICE_URL=https://notify.vubon.com.bd
ANALYTICS_SERVICE_URL=https://analytics.vubon.com.bd

NOTIFICATION_API_KEY=<inject-from-secret-manager>
ANALYTICS_API_KEY=<inject-from-secret-manager>
