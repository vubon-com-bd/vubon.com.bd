{
  "name": "@vubon/auth-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "start:debug": "tsx --inspect-brk watch src/main.ts",
    "start:prod": "node dist/main.js",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@vubon/auth-shared-config": "workspace:*",
    "@vubon/auth-shared-constants": "workspace:*",
    "@vubon/auth-shared-types": "workspace:*",
    "@vubon/auth-shared-utils": "workspace:*",
    "@vubon/auth-shared-schemas": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.3.0",
    "@swc/cli": "^0.3.0",
    "@swc/core": "^1.3.0",
    "@types/node": "^20.8.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
