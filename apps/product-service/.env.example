# ═══════════════════════════════════════════════════════════════════
# PRODUCT-SERVICE — Service-Specific Environment Variables
# ═══════════════════════════════════════════════════════════════════
#
# ⚠️ IMPORTANT:
#   Shared variables (DATABASE_URL, REDIS_URL, JWT_SECRET, etc.)
#   LIVE IN THE ROOT .env file — do NOT duplicate them here.
#
#   Load order (see src/main.ts):
#     1. root/.env                          (base shared)
#     2. apps/product-service/.env          (overrides + service-specific)
#
#   Only put variables here that:
#     • Override shared values for this service
#     • Are unique to product-service
# ═══════════════════════════════════════════════════════════════════

# ─── Service Identity ─────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
TZ=Asia/Dhaka

# ─── Service Port (overrides APP_PORT) ────────────────────────────
PORT=4002

# ─── Search Engine (overrides root if different) ──────────────────
SEARCH_PROVIDER=meilisearch
SEARCH_HOST=http://localhost:7700
SEARCH_API_KEY=masterKey-change-in-prod
SEARCH_PRODUCT_INDEX=products
SEARCH_CATEGORY_INDEX=categories
SEARCH_BATCH_SIZE=100
SEARCH_TIMEOUT_MS=5000
SEARCH_RETRY_ATTEMPTS=3

# ─── Storage ──────────────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_BASE_PATH=./storage/uploads

# ─── Queue (BullMQ) ───────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_DB=1

# ─── Media Processing ─────────────────────────────────────────────
MEDIA_IMAGE_QUALITY=85
MEDIA_IMAGE_MAX_WIDTH=2048
MEDIA_THUMBNAIL_WIDTH=400

# ─── Cache TTLs (seconds) ─────────────────────────────────────────
PRODUCT_CACHE_TTL=300
VARIANT_CACHE_TTL=300
INVENTORY_CACHE_TTL=60
PRICING_CACHE_TTL=300
REVIEW_CACHE_TTL=120
BRAND_CACHE_TTL=600

# ─── Pagination ───────────────────────────────────────────────────
PRODUCT_PAGE_SIZE=20
PRODUCT_MAX_PAGE_SIZE=100

# ─── Feature Flags ────────────────────────────────────────────────
PRODUCT_SEARCH_INDEXING=true
VARIANT_AUTO_MATRIX=true
INVENTORY_LOW_STOCK_ALERTS=true

# ─── Debug (optional) ─────────────────────────────────────────────
# DB_LOGGING=true
# REDIS_LAZY_CONNECT=false
