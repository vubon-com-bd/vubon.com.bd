# ═══════════════════════════════════════════════════════════════
# PRODUCT-SERVICE — Production Environment Template
# ═══════════════════════════════════════════════════════════════
# Copy to `.env.production` and fill in real values.
# NEVER commit `.env.production` with real secrets.
# ═══════════════════════════════════════════════════════════════

# ─── Runtime ──────────────────────────────────────────────────
NODE_ENV=production
PORT=4002
APP_NAME=product-service
LOG_LEVEL=info
TZ=Asia/Dhaka

# ─── Database (Railway Postgres / Supabase) ───────────────────
DATABASE_URL=postgresql://user:pass@host:5432/vubon_prod?sslmode=require
DB_SSL=true
DB_LOGGING=false
DB_TIMEZONE=Asia/Dhaka
DB_POOL_MIN=2
DB_POOL_MAX=10

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://default:pass@host:6379
REDIS_KEY_PREFIX=vubon:
REDIS_DB=0
REDIS_QUEUE_DB=1

# ─── JWT (must match auth-service) ────────────────────────────
JWT_SECRET=REPLACE_WITH_48_RANDOM_CHARS
JWT_ISSUER=vubon-api
JWT_AUDIENCE=vubon-client

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=https://vubon.com.bd,https://admin.vubon.com.bd

# ─── Search (Meilisearch / Elasticsearch) ─────────────────────
SEARCH_PROVIDER=meilisearch
SEARCH_HOST=http://meilisearch.railway.internal:7700
SEARCH_API_KEY=REPLACE_WITH_PRODUCTION_KEY
SEARCH_PRODUCT_INDEX=products
SEARCH_CATEGORY_INDEX=categories
SEARCH_BATCH_SIZE=100
SEARCH_TIMEOUT_MS=5000

# ─── Storage ──────────────────────────────────────────────────
STORAGE_PROVIDER=s3
STORAGE_S3_BUCKET=vubon-media
STORAGE_S3_REGION=ap-southeast-1
STORAGE_S3_ACCESS_KEY=REPLACE
STORAGE_S3_SECRET_KEY=REPLACE
STORAGE_CDN_URL=https://cdn.vubon.com.bd

# ─── Media Limits ─────────────────────────────────────────────
MEDIA_IMAGE_MAX_SIZE_MB=5
MEDIA_VIDEO_MAX_SIZE_MB=100
MEDIA_DOCUMENT_MAX_SIZE_MB=10
MEDIA_IMAGE_QUALITY=85
MEDIA_THUMBNAIL_WIDTH=400

# ─── Cache TTL (seconds) ──────────────────────────────────────
PRODUCT_CACHE_TTL=300
VARIANT_CACHE_TTL=300
INVENTORY_CACHE_TTL=60
PRICING_CACHE_TTL=300
REVIEW_CACHE_TTL=120
BRAND_CACHE_TTL=600

# ─── Pagination ───────────────────────────────────────────────
PRODUCT_PAGE_SIZE=20
PRODUCT_MAX_PAGE_SIZE=100

# ─── Feature flags ────────────────────────────────────────────
PRODUCT_SEARCH_INDEXING=true
VARIANT_AUTO_MATRIX=true
INVENTORY_LOW_STOCK_ALERTS=true
