# ═══════════════════════════════════════════════════════════════
# Product Service — Production Environment Template
# ═══════════════════════════════════════════════════════════════
# Usage: Copy to .env on production server
#   cp .env.production.example .env
# Then fill in production values (secrets, URLs)
# ═══════════════════════════════════════════════════════════════

# ─── App ───
NODE_ENV=production
PORT=3002
APP_NAME=product-service
APP_URL=https://products.vubon.com.bd

# ─── Database Mode (production uses Prisma) ───
DB_MODE=prisma

# ─── Database (Prisma) ───
DATABASE_URL=postgresql://vubon:CHANGE_ME_PASSWORD@postgres:5432/vubon_product
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vubon_product
POSTGRES_USER=vubon
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
DB_DRIVER=postgres
DB_SSL=true
DB_LOGGING=false
DB_TIMEZONE=Asia/Dhaka
DB_SCHEMA=public
DB_MAX_CONNECTIONS=100

# ─── Redis ───
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=product:
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_TLS=false
REDIS_MAX_RETRIES=3
REDIS_LAZY_CONNECT=false

# ─── Queue ───
QUEUE_DRIVER=bull
QUEUE_ENABLED=true
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_DEFAULT_BACKOFF_MS=5000
QUEUE_WORKER_CONCURRENCY=10
QUEUE_AUTO_START_WORKERS=true

# ─── JWT (REQUIRED — min 32 chars) ───
JWT_SECRET=CHANGE_ME_JWT_SECRET_MUST_BE_AT_LEAST_32_CHARACTERS_LONG
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Search (production) ───
SEARCH_URL=https://search.vubon.com.bd
SEARCH_API_KEY=CHANGE_ME_SEARCH_API_KEY

# ─── AWS S3 (production) ───
AWS_REGION=ap-south-1
AWS_ENDPOINT=https://s3.ap-south-1.amazonaws.com
AWS_BUCKET=vubon-products-prod
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_KEY

# ─── Email (production) ───
EMAIL_FROM=products@vubon.com.bd
SENDGRID_API_KEY=CHANGE_ME_SENDGRID_KEY

# ─── Slack Alerts (production) ───
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME

# ─── External Services ───
USER_SERVICE_URL=http://user-service:3001
USER_SERVICE_TIMEOUT=5000
VENDOR_SERVICE_URL=http://vendor-service:3005
VENDOR_SERVICE_TIMEOUT=5000

# ─── Observability ───
LOG_LEVEL=info
SENTRY_DSN=CHANGE_ME_SENTRY_DSN
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ─── Rate Limiting ───
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ─── CORS ───
CORS_ORIGINS=https://vubon.com.bd,https://admin.vubon.com.bd
