# ─── App ─────────────────────────────────────
NODE_ENV=development
PORT=3003
APP_NAME=logistics-service

# ─── Database ────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/vubon_logistics

# ─── Redis ───────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=logistics:
REDIS_QUEUE_DB=5

# ─── JWT (shared with auth-service) ──────────
JWT_SECRET=your-secret-here
JWT_ISSUER=vubon-api
JWT_AUDIENCE=vubon-client

# ─── Courier APIs ────────────────────────────
SA_PARIBAHAN_API_KEY=
SA_PARIBAHAN_API_URL=
REDX_API_KEY=
REDX_API_URL=
PATHAO_API_KEY=
PATHAO_API_URL=
STEADFAST_API_KEY=
STEADFAST_API_URL=
PAPERFLY_API_KEY=
PAPERFLY_API_URL=

# ─── Maps ────────────────────────────────────
GOOGLE_MAPS_API_KEY=
OPENSTREETMAP_API_URL=https://nominatim.openstreetmap.org
