# ═══════════════════════════════════════════════════════════════
# Product Service — Environment Template
# ═══════════════════════════════════════════════════════════════
# Copy to .env and adjust values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ─── App ───
NODE_ENV=development
PORT=3002
APP_NAME=product-service
APP_URL=http://localhost:3002

# ─── Database Mode ───
# memory = InMemory repositories (Termux ARM64, dev, testing)
# prisma = PostgreSQL via Prisma (production)
DB_MODE=memory

# ─── Database (Prisma) ───
DATABASE_URL=postgresql://vubon:vubon@localhost:5432/vubon_product
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vubon_product
POSTGRES_USER=vubon
POSTGRES_PASSWORD=vubon
DB_DRIVER=postgres
DB_SSL=false
DB_LOGGING=false
DB_TIMEZONE=Asia/Dhaka
DB_SCHEMA=public
DB_MAX_CONNECTIONS=100

# ─── Redis ───
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=product:
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_MAX_RETRIES=3
REDIS_LAZY_CONNECT=false

# ─── Queue ───
QUEUE_DRIVER=bull
QUEUE_ENABLED=true
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_DEFAULT_BACKOFF_MS=5000
QUEUE_WORKER_CONCURRENCY=5
QUEUE_AUTO_START_WORKERS=true

# ─── JWT (for guards) ───
JWT_SECRET=change_me_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=15m

# ─── Search (optional) ───
SEARCH_URL=
SEARCH_API_KEY=

# ─── AWS S3 (optional) ───
AWS_REGION=us-east-1
AWS_ENDPOINT=
AWS_BUCKET=vubon-products
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Email / Slack (optional) ───
EMAIL_FROM=products@vubon.com.bd
SENDGRID_API_KEY=
SLACK_WEBHOOK_URL=

# ─── External Services ───
USER_SERVICE_URL=http://localhost:3001
USER_SERVICE_TIMEOUT=5000
VENDOR_SERVICE_URL=http://localhost:3005
VENDOR_SERVICE_TIMEOUT=5000

# ─── Logging ───
LOG_LEVEL=debug

SERVICE_NAME=product
