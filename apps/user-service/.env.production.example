# ═══════════════════════════════════════════════════════════════
# user-service — Production Environment Template
# ═══════════════════════════════════════════════════════════════
# Copy to Railway dashboard variables. Do NOT commit real values.

# ─── Runtime ──────────────────────────────────────────────────
NODE_ENV=production
PORT=4001
APP_NAME=user-service

# ─── Database (Railway PostgreSQL) ────────────────────────────
# Reference the Postgres plugin:
DATABASE_URL=${{Postgres.DATABASE_URL}}
DB_SSL=true
DB_LOGGING=false
DB_TIMEZONE=Asia/Dhaka
DB_SCHEMA=public

# ─── Redis (Railway Redis) ────────────────────────────────────
REDIS_URL=${{Redis.REDIS_URL}}
REDIS_KEY_PREFIX=vubon:
REDIS_DB=0
REDIS_TLS=false

# ─── JWT (shared with auth-service) ───────────────────────────
JWT_SECRET=REPLACE_WITH_STRONG_32_PLUS_CHAR_SECRET
JWT_ISSUER=vubon-api
JWT_AUDIENCE=vubon-client
JWT_ALGORITHM=HS256

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=https://your-frontend.com

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Queue ────────────────────────────────────────────────────
QUEUE_DRIVER=bull
QUEUE_ENABLED=true
QUEUE_WORKER_CONCURRENCY=5

# ─── Feature Flags ────────────────────────────────────────────
USER_MAX_PROFILES=5
USER_MAX_ADDRESSES=20
USER_MAX_CONTACTS=10
USER_PROFILE_COMPLETION_THRESHOLD=80
USER_DEFAULT_TIMEZONE=Asia/Dhaka
USER_DEFAULT_LANGUAGE=bn
USER_DEFAULT_LOCALE=bn-BD

ACTIVITY_RETENTION_DAYS=90
KYC_EXPIRY_DAYS=365

# ─── DO NOT SET IN PRODUCTION ─────────────────────────────────
# USE_IN_MEMORY_REPOS=true
