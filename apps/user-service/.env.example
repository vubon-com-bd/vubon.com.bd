# ═══════════════════════════════════════════════════════════════
# user-service — Local Development Environment
# ═══════════════════════════════════════════════════════════════
# Copy to .env and adjust.

# ─── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4001
APP_NAME=user-service
APP_URL=http://localhost:4001
API_URL=http://localhost:4001/api

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vubon_user?schema=public
DB_SSL=false
DB_LOGGING=true

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=vubon:
REDIS_DB=0

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=local-dev-secret-min-32-chars-please-change
JWT_ISSUER=vubon-api
JWT_AUDIENCE=vubon-client

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── User Service Config ──────────────────────────────────────
USER_MAX_PROFILES=5
USER_MAX_ADDRESSES=20
USER_MAX_CONTACTS=10
USER_PROFILE_COMPLETION_THRESHOLD=80
USER_DEFAULT_TIMEZONE=Asia/Dhaka
USER_DEFAULT_LANGUAGE=bn
USER_DEFAULT_LOCALE=bn-BD

# ─── Profile ──────────────────────────────────────────────────
PROFILE_COMPLETION_CACHE_TTL=300

# ─── Preferences ──────────────────────────────────────────────
PREFERENCES_DEFAULT_PAGE_SIZE=20
PREFERENCES_CACHE_TTL=3600

# ─── Activity ─────────────────────────────────────────────────
ACTIVITY_RETENTION_DAYS=90
ACTIVITY_CLEANUP_BATCH=1000
ACTIVITY_STATS_CACHE_TTL=600

# ─── KYC ──────────────────────────────────────────────────────
KYC_EXPIRY_DAYS=365
KYC_REVIEW_SLA_HOURS=48

# ─── Avatar ───────────────────────────────────────────────────
AVATAR_MAX_WIDTH=1024
AVATAR_MAX_HEIGHT=1024

# ─── Queue ────────────────────────────────────────────────────
REDIS_QUEUE_DB=3
REDIS_QUEUE_CONCURRENCY=5

# ─── Dev/Test only (Termux Prisma workaround) ─────────────────
USE_IN_MEMORY_REPOS=false
