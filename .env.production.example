# ═══════════════════════════════════════════════════════════
# Vubon.com.bd — Production Environment
# ═══════════════════════════════════════════════════════════
# Copy to .env.production and fill in real values
# NEVER commit .env.production to git

# ─── Core ───────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# ─── PostgreSQL ─────────────────────────────────
POSTGRES_USER=vubon
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis ──────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# ─── JWT (MUST match across all services) ───────
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_STRING
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# ─── Service URLs (internal docker network) ─────
IDENTITY_SERVICE_URL=http://identity:3001
PRODUCT_SERVICE_URL=http://product:3002
VENDOR_SERVICE_URL=http://vendor:3003
CART_SERVICE_URL=http://cart:3004
ORDER_SERVICE_URL=http://order:3005
PAYMENT_SERVICE_URL=http://payment:3006
NOTIFICATION_SERVICE_URL=http://notification:4006

# ─── Email (production provider) ────────────────
EMAIL_ENABLED=true
SMTP_ENABLED=false
SENDGRID_ENABLED=true
SENDGRID_API_KEY=SG.CHANGE_ME
SENDGRID_FROM_EMAIL=noreply@vubon.com.bd
SENDGRID_FROM_NAME=Vubon
RESEND_ENABLED=false
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME@gmail.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM="Vubon <noreply@vubon.com.bd>"
SMTP_FROM_NAME=Vubon
SMTP_FROM_EMAIL=noreply@vubon.com.bd

# ─── SMS (production) ───────────────────────────
SMS_ENABLED=false
SSLWIRELESS_API_KEY=
BULKSMSBD_API_KEY=

# ─── Payment Gateways ───────────────────────────
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# ─── URLs ───────────────────────────────────────
APP_URL=https://vubon.com.bd
API_URL=https://vubon.com.bd/api
FRONTEND_URL=https://vubon.com.bd
CORS_ORIGINS=https://vubon.com.bd,https://www.vubon.com.bd

# ─── Rate limiting ──────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Persistence mode ───────────────────────────
# production = prisma | development = memory
PERSISTENCE_DRIVER=prisma
DB_MODE=prisma
