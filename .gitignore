# ═══════════════════════════════════════════════════════════════
# Vubon.com.bd — Git Ignore Rules
# ═══════════════════════════════════════════════════════════════

# ─── Dependencies ──────────────────────────────────────────────
node_modules/
.pnpm-store/

# ─── Environment Files ─────────────────────────────────────────
# Ignore all .env files
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.production
.env.test

# But KEEP template files
!.env.example
!**/.env.example

# ─── Build Output ──────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ─── Prisma ────────────────────────────────────────────────────
prisma/migrations/**/*.sql
!prisma/migrations/migration_lock.toml

# ─── Test Coverage ─────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Logs ──────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS Files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ─── IDE / Editor ──────────────────────────────────────────────
.vscode/
.idea/
*.iml
*.sublime-*

# ─── Test / Scratch Files ──────────────────────────────────────
*.test.ts.snap
__snapshots__/
.scratch/
tmp/
temp/

# ─── Cache ─────────────────────────────────────────────────────
.cache/
.eslintcache
.prettier-cache
.turbo/
.parcel-cache/

# ─── Local Storage ─────────────────────────────────────────────
storage/
uploads/

# Backup files
*.bak
*.bak.*
.env.backup.*
package.json.backup.*

# Jest
.skip/

# Redis
dump.rdb

# tsbuildinfo
*.tsbuildinfo


# Backup files
*.bak
*.bak.*
.env.backup.*
package.json.backup.*

# Jest
.skip/

# Redis
dump.rdb

# TypeScript build info
*.tsbuildinfo

# Auth-service test outputs
apps/auth-service/coverage/

