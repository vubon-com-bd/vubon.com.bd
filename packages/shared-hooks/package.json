{
  "name": "@vubon/shared-hooks",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./primitive": {
      "import": "./dist/primitive/index.js",
      "require": "./dist/primitive/index.js",
      "types": "./dist/primitive/index.d.ts"
    },
    "./utility": {
      "import": "./dist/utility/index.js",
      "require": "./dist/utility/index.js",
      "types": "./dist/utility/index.d.ts"
    },
    "./integration": {
      "import": "./dist/integration/index.js",
      "require": "./dist/integration/index.js",
      "types": "./dist/integration/index.d.ts"
    },
    "./table": {
      "import": "./dist/table/index.js",
      "require": "./dist/table/index.js",
      "types": "./dist/table/index.d.ts"
    },
    "./form": {
      "import": "./dist/form/index.js",
      "require": "./dist/form/index.js",
      "types": "./dist/form/index.d.ts"
    },
    "./ui": {
      "import": "./dist/ui/index.js",
      "require": "./dist/ui/index.js",
      "types": "./dist/ui/index.d.ts"
    },
    "./business": {
      "import": "./dist/business/index.js",
      "require": "./dist/business/index.js",
      "types": "./dist/business/index.d.ts"
    },
    "./admin": {
      "import": "./dist/admin/index.js",
      "require": "./dist/admin/index.js",
      "types": "./dist/admin/index.d.ts"
    },
    "./seller": {
      "import": "./dist/seller/index.js",
      "require": "./dist/seller/index.js",
      "types": "./dist/seller/index.d.ts"
    },
    "./customer": {
      "import": "./dist/customer/index.js",
      "require": "./dist/customer/index.js",
      "types": "./dist/customer/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.0.0",
    "react": "^18.2.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@vubon/shared-api": "workspace:*",
    "@vubon/shared-auth": "workspace:*",
    "@vubon/shared-config": "workspace:*",
    "@vubon/shared-constants": "workspace:*",
    "@vubon/shared-schemas": "workspace:*",
    "@vubon/shared-types": "workspace:*",
    "@vubon/shared-utils": "workspace:*",
    "zod": "4.5.4"
  },
  "type": "module"
}
