{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "tsconfig.json",
    "assets": [
      {
        "include": "**/*.env",
        "watchAssets": true
      },
      {
        "include": "**/*.yaml",
        "watchAssets": true
      }
    ],
    "watchAssets": true
  },
  "generateOptions": {
    "spec": true,
    "flat": false
  },
  "monorepo": false,
  "projects": {
    "backend-service": {
      "type": "application",
      "root": ".",
      "entryFile": "main",
      "sourceRoot": "src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.json",
        "assets": [
          {
            "include": "**/*.env",
            "watchAssets": true
          }
        ],
        "watchAssets": true
      }
    }
  }
}
