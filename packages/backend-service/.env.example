# ====================
# সার্ভার কনফিগারেশন
# ====================
PORT=5000
NODE_ENV=development
APP_NAME=Vubon
APP_VERSION=1.0.0
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# ====================
# ডেটাবেস কনফিগারেশন (Neon PostgreSQL)
# ====================
# Neon PostgreSQL ডেটাবেস URL (প্রতিস্থাপন করুন)
DATABASE_URL=postgresql://neondb_owner:npg_DPz2o9edGkIW@ep-tiny-scene-azaorvjq.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# অথবা আলাদা কনফিগারেশন
DB_HOST=ep-tiny-scene-azaorvjq.c-3.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=npg_DPz2o9edGkIW
DB_SSL=true
DB_LOGGING=true
DB_SYNCHRONIZE=false

# ====================
# Redis কনফিগারেশন (ঐচ্ছিক)
# ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# ====================
# JWT কনফিগারেশন (ন্যূনতম ৩২ অক্ষর)
# ====================
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars-12345
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-1234
JWT_VERIFICATION_SECRET=your-super-secret-verification-key-min-32-chars
JWT_RESET_SECRET=your-super-secret-reset-key-min-32-characters-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_VERIFICATION_EXPIRY=24h
JWT_RESET_EXPIRY=30m
JWT_ISSUER=vubon.com
JWT_AUDIENCE=vubon-api
JWT_ALGORITHM=HS256
JWT_ENABLE_ROTATION=true

# ====================
# OAuth কনফিগারেশন (সব ডিজেবল)
# ====================
OAUTH_ENABLED=false
OAUTH_ALLOW_ACCOUNT_LINKING=false
OAUTH_ALLOW_REGISTRATION=false

# Google
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Facebook
FACEBOOK_ENABLED=false
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=

# GitHub
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Apple
APPLE_ENABLED=false
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=

# LinkedIn
LINKEDIN_ENABLED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=

# ====================
# নিরাপত্তা কনফিগারেশন
# ====================
BCRYPT_SALT_ROUNDS=12
ENABLE_CSRF=false
ENABLE_HELMET=false
ENABLE_IP_BLOCKING=false
ENABLE_SESSION_ENCRYPTION=false

# ====================
# ইমেইল কনফিগারেশন (ডিজেবল)
# ====================
EMAIL_ENABLED=false
EMAIL_PROVIDER=nodemailer
EMAIL_FROM=noreply@vubon.com
EMAIL_FROM_NAME=Vubon

# ====================
# ফিচার ফ্ল্যাগ
# ====================
FEATURE_REGISTRATION=true
FEATURE_EMAIL_VERIFICATION=false
FEATURE_PHONE_VERIFICATION=false
FEATURE_MFA=false
FEATURE_MFA_ADMIN_ONLY=false
FEATURE_SOCIAL_LOGIN=false
FEATURE_PASSWORD_RESET=true
FEATURE_REMEMBER_ME=true
FEATURE_SESSION_MANAGEMENT=false
FEATURE_DEVICE_MANAGEMENT=false
FEATURE_EMAIL_NOTIFICATIONS=false
FEATURE_SMS_NOTIFICATIONS=false
FEATURE_ANALYTICS=false

# ====================
# CORS & লগিং
# ====================
ENABLE_CORS=true
CORS_ORIGINS=*
ENABLE_LOGGING=true
LOG_LEVEL=info
ENABLE_COMPRESSION=true
ENABLE_GRACEFUL_SHUTDOWN=true
GRACEFUL_SHUTDOWN_TIMEOUT=10000
