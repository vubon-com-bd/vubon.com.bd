NODE_ENV=test
PORT=3001
JWT_ACCESS_SECRET=test-access-secret-min-32-chars-here-12345
JWT_REFRESH_SECRET=test-refresh-secret-min-32-chars-here-123
JWT_VERIFICATION_SECRET=test-verification-secret-min-32-chars
JWT_RESET_SECRET=test-reset-secret-min-32-characters-here
JWT_ISSUER=test-issuer
JWT_AUDIENCE=test-audience
API_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173
APP_NAME=Vubon Test
APP_VERSION=1.0.0
ENABLE_CORS=true
CORS_ORIGINS=*
ENABLE_COMPRESSION=true
ENABLE_LOGGING=false
LOG_LEVEL=error
ENABLE_GRACEFUL_SHUTDOWN=true
GRACEFUL_SHUTDOWN_TIMEOUT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=vubon_test_db
DB_USER=postgres
DB_PASSWORD=test
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000
DB_LOGGING=false
DB_SSL=false
DB_SYNCHRONIZE=false
DB_TYPE=postgres

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
REDIS_KEY_PREFIX=vubon:test:
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100
REDIS_TLS=false

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_VERIFICATION_EXPIRY=24h
JWT_RESET_EXPIRY=30m
JWT_ALGORITHM=HS256
JWT_ENABLE_ROTATION=true

BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
ENABLE_CSRF=false
CSRF_TOKEN_EXPIRY=3600
ENABLE_HELMET=false
ENABLE_IP_BLOCKING=false
IP_BLOCK_DURATION_MINUTES=60
ENABLE_SESSION_ENCRYPTION=false

EMAIL_ENABLED=false
EMAIL_PROVIDER=nodemailer
EMAIL_FROM=test@vubon.com
EMAIL_FROM_NAME=Vubon Test

FEATURE_REGISTRATION=true
FEATURE_EMAIL_VERIFICATION=false
FEATURE_PHONE_VERIFICATION=false
FEATURE_MFA=false
FEATURE_MFA_ADMIN_ONLY=false
FEATURE_SOCIAL_LOGIN=false
FEATURE_PASSWORD_RESET=false
FEATURE_REMEMBER_ME=true
FEATURE_SESSION_MANAGEMENT=false
FEATURE_DEVICE_MANAGEMENT=false
FEATURE_EMAIL_NOTIFICATIONS=false
FEATURE_SMS_NOTIFICATIONS=false
FEATURE_ANALYTICS=false

OAUTH_ENABLED=false
OAUTH_ALLOW_ACCOUNT_LINKING=false
OAUTH_ALLOW_REGISTRATION=false
GOOGLE_ENABLED=false
FACEBOOK_ENABLED=false
GITHUB_ENABLED=false
APPLE_ENABLED=false
LINKEDIN_ENABLED=false
