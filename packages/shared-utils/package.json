{
  "name": "@vubon/shared-utils",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./infrastructure": {
      "types": "./dist/infrastructure/index.d.ts",
      "import": "./dist/infrastructure/index.js",
      "require": "./dist/infrastructure/index.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "import": "./dist/security/index.js",
      "require": "./dist/security/index.js"
    },
    "./common": {
      "import": "./dist/common/index.js",
      "require": "./dist/common/index.js",
      "types": "./dist/common/index.d.ts"
    },
    "./generator": {
      "types": "./dist/generator/index.d.ts",
      "import": "./dist/generator/index.js",
      "require": "./dist/generator/index.js",
      "default": "./dist/generator/index.js"
    },
    "./generator/business": {
      "types": "./dist/generator/business/index.d.ts",
      "import": "./dist/generator/business/index.js",
      "require": "./dist/generator/business/index.js",
      "default": "./dist/generator/business/index.js"
    },
    "./validator": {
      "types": "./dist/validator/index.d.ts",
      "import": "./dist/validator/index.js",
      "require": "./dist/validator/index.js",
      "default": "./dist/validator/index.js"
    },
    "./validator/business": {
      "types": "./dist/validator/business/index.d.ts",
      "import": "./dist/validator/business/index.js",
      "require": "./dist/validator/business/index.js",
      "default": "./dist/validator/business/index.js"
    },
    "./calculator": {
      "types": "./dist/calculator/index.d.ts",
      "import": "./dist/calculator/index.js",
      "require": "./dist/calculator/index.js",
      "default": "./dist/calculator/index.js"
    },
    "./calculator/logistics": {
      "types": "./dist/calculator/logistics/index.d.ts",
      "import": "./dist/calculator/logistics/index.js",
      "require": "./dist/calculator/logistics/index.js",
      "default": "./dist/calculator/logistics/index.js"
    },
    "./formatter": {
      "types": "./dist/formatter/index.d.ts",
      "import": "./dist/formatter/index.js",
      "require": "./dist/formatter/index.js",
      "default": "./dist/formatter/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format:write": "prettier --write \"src/**/*.ts\"",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "tsc-alias": "^1.9.5"
  },
  "dependencies": {
    "@vubon/shared-constants": "workspace:*",
    "@vubon/shared-schemas": "workspace:*",
    "@vubon/shared-types": "workspace:*",
    "zod": "4.5.4"
  }
}
