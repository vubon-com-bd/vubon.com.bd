{
  "name": "@vubon/shared-config",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./common": {
      "import": "./dist/common/index.js",
      "require": "./dist/common/index.js",
      "types": "./dist/common/index.d.ts"
    },
    "./database": {
      "import": "./dist/common/database.config.js",
      "require": "./dist/common/database.config.js",
      "types": "./dist/common/database.config.d.ts"
    },
    "./redis": {
      "import": "./dist/common/redis.config.js",
      "require": "./dist/common/redis.config.js",
      "types": "./dist/common/redis.config.d.ts"
    },
    "./jwt": {
      "import": "./dist/common/jwt.config.js",
      "require": "./dist/common/jwt.config.js",
      "types": "./dist/common/jwt.config.d.ts"
    },
    "./rate-limit": {
      "import": "./dist/common/rate-limit.config.js",
      "require": "./dist/common/rate-limit.config.js",
      "types": "./dist/common/rate-limit.config.d.ts"
    },
    "./cors": {
      "import": "./dist/common/cors.config.js",
      "require": "./dist/common/cors.config.js",
      "types": "./dist/common/cors.config.d.ts"
    },
    "./payment": {
      "import": "./dist/common/payment.config.js",
      "require": "./dist/common/payment.config.js",
      "types": "./dist/common/payment.config.d.ts"
    },
    "./sms": {
      "import": "./dist/common/sms.config.js",
      "require": "./dist/common/sms.config.js",
      "types": "./dist/common/sms.config.d.ts"
    },
    "./email": {
      "import": "./dist/common/email.config.js",
      "require": "./dist/common/email.config.js",
      "types": "./dist/common/email.config.d.ts"
    },
    "./server": {
      "import": "./dist/common/server.config.js",
      "require": "./dist/common/server.config.js",
      "types": "./dist/common/server.config.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format:write": "prettier --write \"src/**/*.ts\"",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@vubon/shared-constants": "workspace:*"
  }
}
