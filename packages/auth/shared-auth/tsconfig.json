{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["react", "react-dom", "node"],
    "skipLibCheck": true,
    "paths": {
      "@vubon/auth-shared-api": ["../shared-api/src"],
      "@vubon/auth-shared-types": ["../shared-types/src"],
      "@vubon/auth-shared-constants": ["../shared-constants/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
