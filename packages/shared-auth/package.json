{
  "name": "@vubon/shared-auth",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./common": {
      "import": "./dist/common/index.js",
      "require": "./dist/common/index.js",
      "types": "./dist/common/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/passport": "12.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^20.19.43",
    "@types/passport-facebook": "3.0.4",
    "@types/passport-github2": "1.2.9",
    "@types/passport-google-oauth20": "2.0.17",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/react": "^18.3.31",
    "@types/react-dom": "19.2.6",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "globals": "^15.0.0",
    "jsonwebtoken": "9.0.3",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "prettier": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "19.2.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@nestjs/platform-express": "12.0.2",
    "@vubon/shared-api": "workspace:*",
    "@vubon/shared-config": "workspace:*",
    "@vubon/shared-constants": "workspace:*",
    "@vubon/shared-schemas": "workspace:*",
    "@vubon/shared-types": "workspace:*",
    "@vubon/shared-utils": "workspace:*",
    "bcryptjs": "^2.4.3",
    "next": "16.3.5",
    "passport-facebook": "3.0.0",
    "passport-github2": "0.1.12",
    "passport-google-oauth20": "2.0.0",
    "zod": "4.5.4"
  }
}
