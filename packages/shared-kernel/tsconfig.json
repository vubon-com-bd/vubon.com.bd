{
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",

    "module": "CommonJS",
    "target": "ES2020",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "types": ["node"],

    "baseUrl": ".",
    "paths": {
      "@vubon/shared-constants": ["../shared-constants/src/index.ts"],
      "@vubon/shared-constants/*": ["../shared-constants/src/*"],
      "@vubon/shared-types": ["../shared-types/src/index.ts"],
      "@vubon/shared-types/*": ["../shared-types/src/*"],
      "@vubon/shared-utils": ["../shared-utils/src/index.ts"],
      "@vubon/shared-utils/*": ["../shared-utils/src/*"],
      "@vubon/shared-config": ["../shared-config/src/index.ts"],
      "@vubon/shared-config/*": ["../shared-config/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
