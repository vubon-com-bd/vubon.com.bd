// ═══════════════════════════════════════════════════════════════
// shared-kernel Prisma Schema — SINGLE SOURCE OF TRUTH
// ═══════════════════════════════════════════════════════════════
// All services in the vubon.com.bd monorepo import PrismaClient
// from @vubon/shared-kernel to avoid schema generation conflicts.
// ═══════════════════════════════════════════════════════════════

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// USER — Core identity
// ═══════════════════════════════════════════════════════════════

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  phone         String?
  status        String    @default("active")
  type          String    @default("customer")
  role          String    @default("user")
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  sessions       AuthSession[]
  tokens         AuthToken[]
  mfa            AuthMfa?
  devices        AuthDevice[]
  socials        AuthSocial[]
  oauths         AuthOAuth[]
  ssos           AuthSso[]
  loginAttempts  AuthLoginAttempt[]
  accountLock    AuthAccountLock?
  recoveryCodes  AuthRecoveryCode[]
  twoFa          Auth2Fa?
  biometrics     AuthBiometric[]
  userRoles      UserRole[]
  userPermissions UserPermission[]

  profile        UserProfile?
  settings       UserSettings?
  preferences    UserPreferences?
  settingsKV     UserSetting[]
  preferencesKV  UserPreference[]
  addresses      UserAddress[]
  contacts       UserContact[]
  verifications  UserVerification[]
  kyc            UserKyc?
  activities     UserActivity[]

  @@index([email])
  @@index([status])
  @@index([type])
  @@map("users")
}

model UserProfile {
  id           String    @id @default(uuid())
  userId       String    @unique
  firstName    String?
  lastName     String?
  bio          String?
  avatarUrl    String?
  coverUrl     String?
  dateOfBirth  DateTime?
  gender       String?
  website      String?
  company      String?
  designation  String?
  visibility   String    @default("public")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSettings {
  id                 String   @id @default(uuid())
  userId             String   @unique
  language           String   @default("en")
  timezone           String   @default("UTC")
  currency           String   @default("BDT")
  theme              String   @default("system")
  emailNotifications Boolean  @default(true)
  smsNotifications   Boolean  @default(false)
  pushNotifications  Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserSetting {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@map("user_settings_kv")
}

model UserPreferences {
  id              String   @id @default(uuid())
  userId          String   @unique
  marketingEmails Boolean  @default(false)
  productUpdates  Boolean  @default(true)
  orderUpdates    Boolean  @default(true)
  securityAlerts  Boolean  @default(true)
  newsletter      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@map("user_preferences_kv")
}

model UserAddress {
  id          String    @id @default(uuid())
  userId      String
  label       String    @default("Home")
  fullName    String?
  phone       String?
  division    String
  district    String
  upazila     String?
  addressLine String
  line1       String?
  line2       String?
  city        String?
  postalCode  String?
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@map("user_addresses")
}

model UserContact {
  id             String   @id @default(uuid())
  userId         String
  type           String?
  value          String?
  verified       Boolean  @default(false)
  isPrimary      Boolean  @default(false)
  email          String?
  phone          String?
  alternatePhone String?
  alternateEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
  @@map("user_contacts")
}

model UserVerification {
  id         String    @id @default(uuid())
  userId     String
  type       String
  code       String
  status     String    @default("pending")
  verifiedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_verifications")
}

model UserKyc {
  id              String    @id @default(uuid())
  userId          String    @unique
  status          String    @default("not_started")
  documentType    String?
  documentNumber  String?
  documentUrl     String?
  document        String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("user_kyc")
}

model UserActivity {
  id        String   @id @default(uuid())
  userId    String
  type      String
  category  String?
  ip        String?
  userAgent String?
  metadata  Json?
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, timestamp])
  @@index([timestamp])
  @@map("user_activities")
}

model AuthSession {
  id           String    @id @default(uuid())
  userId       String
  token        String    @unique
  expiry       DateTime
  ip           String
  userAgent    String
  deviceId     String?
  revokedAt    DateTime?
  revokeReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("auth_sessions")
}

model AuthToken {
  id         String    @id @default(uuid())
  userId     String
  tokenValue String    @unique
  tokenType  String
  expiry     DateTime
  issuedAt   DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_tokens")
}

model AuthMfa {
  id             String    @id @default(uuid())
  userId         String    @unique
  secret         String
  type           String
  status         String    @default("pending")
  enabledAt      DateTime?
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_mfa")
}

model AuthRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  code      String
  status    String    @default("active")
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_recovery_codes")
}

model AuthAccountLock {
  id         String    @id @default(uuid())
  userId     String    @unique
  reason     String
  lockedAt   DateTime  @default(now())
  expiresAt  DateTime
  unlockedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_account_locks")
}

model AuthLoginAttempt {
  id          String   @id @default(uuid())
  userId      String?
  email       String?
  ip          String
  userAgent   String
  status      String
  attemptedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([ip])
  @@map("auth_login_attempts")
}

model AuthDevice {
  id          String    @id @default(uuid())
  userId      String
  fingerprint String
  type        String
  status      String    @default("untrusted")
  name        String?
  lastSeenAt  DateTime  @default(now())
  trustedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fingerprint])
  @@map("auth_devices")
}

model AuthSocial {
  id             String    @id @default(uuid())
  userId         String
  provider       String
  providerUserId String
  accessToken    String
  refreshToken   String?
  status         String    @default("linked")
  linkedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("auth_socials")
}

model AuthOAuth {
  id           String    @id @default(uuid())
  userId       String
  provider     String
  accessToken  String
  refreshToken String?
  scope        String
  status       String    @default("active")
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("auth_oauths")
}

model AuthSso {
  id           String    @id @default(uuid())
  userId       String
  provider     String
  externalId   String
  sessionToken String
  status       String    @default("active")
  linkedAt     DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([externalId])
  @@index([userId])
  @@map("auth_ssos")
}

model Auth2Fa {
  id                   String    @id @default(uuid())
  userId               String    @unique
  isEnabled            Boolean   @default(false)
  method               String    @default("totp")
  backupCodesRemaining Int       @default(0)
  enabledAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_2fa")
}

model AuthBiometric {
  id          String    @id @default(uuid())
  userId      String
  biometricId String
  type        String
  isEnabled   Boolean   @default(false)
  enrolledAt  DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_biometrics")
}

model AuthPermission {
  id          String   @id @default(uuid())
  name        String   @unique
  action      String
  resource    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  roles           AuthRolePermission[]
  userPermissions UserPermission[]

  @@index([resource])
  @@map("auth_permissions")
}

model AuthRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  permissions AuthRolePermission[]
  userRoles   UserRole[]

  @@map("auth_roles")
}

model AuthRolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       AuthRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AuthPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("auth_role_permissions")
}

model AuthSettings {
  id                    String   @id @default(uuid())
  userId                String   @unique
  mfaRequired           Boolean  @default(false)
  sessionTimeoutMinutes Int      @default(60)
  passwordExpiryDays    Int      @default(90)
  loginNotifications    Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  @@map("auth_settings")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AuthRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

model UserPermission {
  id           String   @id @default(uuid())
  userId       String
  permissionId String
  createdAt    DateTime @default(now())

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission AuthPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@map("user_permissions")
}

// ═══════════════════════════════════════════════════════════════
// PRODUCT DOMAIN — product-service
// ═══════════════════════════════════════════════════════════════

model Product {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String    @db.VarChar(200)
  slug                String    @unique @db.VarChar(180)
  sku                 String    @unique @db.VarChar(64)
  barcode             String?   @db.VarChar(64)
  type                String    @db.VarChar(30)
  status              String    @db.VarChar(30)
  description         String?   @db.Text
  shortDescription    String?   @db.VarChar(500)
  categoryId          String    @db.Uuid
  brandId             String?   @db.Uuid
  vendorId            String?   @db.Uuid
  price               Decimal   @db.Decimal(12, 2)
  compareAtPrice      Decimal?  @db.Decimal(12, 2)
  currency            String    @db.VarChar(3)
  tags                String[]  @default([])
  images              String[]  @default([])
  thumbnailUrl        String?
  videoUrl            String?
  totalStock          Int       @default(0)
  isFeatured          Boolean   @default(false)
  isPublished         Boolean   @default(false)
  publishedAt         DateTime?
  weight              Decimal?  @db.Decimal(10, 3)
  dimensions          Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  variants            ProductVariant[]
  inventory           ProductInventory[]
  pricing             ProductPricing?
  media               ProductMedia[]
  attributes          ProductAttribute[]
  reviews             ProductReview[]
  collections         CollectionProduct[]

  @@index([slug])
  @@index([sku])
  @@index([status])
  @@index([type])
  @@index([categoryId])
  @@index([brandId])
  @@index([vendorId])
  @@index([isFeatured])
  @@index([deletedAt])
  @@map("products")
}

model ProductVariant {
  id              String    @id @default(uuid()) @db.Uuid
  productId       String    @db.Uuid
  name            String    @db.VarChar(100)
  sku             String    @unique @db.VarChar(64)
  barcode         String?   @db.VarChar(64)
  type            String    @db.VarChar(30)
  options         Json
  price           Decimal   @db.Decimal(12, 2)
  compareAtPrice  Decimal?  @db.Decimal(12, 2)
  cost            Decimal?  @db.Decimal(12, 2)
  weight          Decimal?  @db.Decimal(10, 3)
  imageUrl        String?
  status          String    @db.VarChar(30)
  stock           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model ProductInventory {
  id                  String    @id @default(uuid()) @db.Uuid
  productId           String    @db.Uuid
  variantId           String?   @db.Uuid
  sku                 String    @db.VarChar(64)
  quantity            Int       @default(0)
  reserved            Int       @default(0)
  lowStockThreshold   Int       @default(10)
  trackQuantity       Boolean   @default(true)
  allowBackorder      Boolean   @default(false)
  locationId          String?   @db.Uuid
  lastRestockedAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  product             Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@index([sku])
  @@map("product_inventory")
}

model ProductPricing {
  id                  String    @id @default(uuid()) @db.Uuid
  productId           String    @unique @db.Uuid
  variantId           String?   @db.Uuid
  type                String    @db.VarChar(30)
  basePrice           Decimal   @db.Decimal(12, 2)
  sellingPrice        Decimal   @db.Decimal(12, 2)
  compareAtPrice      Decimal?  @db.Decimal(12, 2)
  costPrice           Decimal?  @db.Decimal(12, 2)
  wholesalePrice      Decimal?  @db.Decimal(12, 2)
  msrp                Decimal?  @db.Decimal(12, 2)
  currency            String    @db.VarChar(3)
  taxRate             Decimal   @default(0) @db.Decimal(5, 4)
  taxInclusive        Boolean   @default(true)
  discountPercent     Decimal   @default(0) @db.Decimal(5, 2)
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  product             Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@map("product_pricing")
}

model ProductMedia {
  id              String    @id @default(uuid()) @db.Uuid
  productId       String    @db.Uuid
  type            String    @db.VarChar(20)
  url             String    @db.Text
  thumbnailUrl    String?   @db.Text
  alt             String?   @db.VarChar(255)
  sortOrder       Int       @default(0)
  sizeBytes       Int?
  mimeType        String?   @db.VarChar(100)
  width           Int?
  height          Int?
  isPrimary       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isPrimary])
  @@map("product_media")
}

model ProductAttribute {
  id              String    @id @default(uuid()) @db.Uuid
  productId       String    @db.Uuid
  name            String    @db.VarChar(100)
  slug            String    @db.VarChar(120)
  type            String    @db.VarChar(30)
  isRequired      Boolean   @default(false)
  isSearchable    Boolean   @default(true)
  isFilterable    Boolean   @default(true)
  unit            String?   @db.VarChar(20)
  options         Json?
  value           Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([slug])
  @@map("product_attributes")
}

model ProductReview {
  id                  String    @id @default(uuid()) @db.Uuid
  productId           String    @db.Uuid
  userId              String    @db.Uuid
  orderId             String?   @db.Uuid
  rating              Int       @db.SmallInt
  title               String?   @db.VarChar(150)
  comment             String?   @db.Text
  images              String[]  @default([])
  status              String    @db.VarChar(30)
  isVerifiedPurchase  Boolean   @default(false)
  helpfulCount        Int       @default(0)
  reportCount         Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  product             Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([status])
  @@map("product_reviews")
}

model Brand {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(100)
  slug            String    @unique @db.VarChar(120)
  description     String?   @db.Text
  logoUrl         String?
  bannerUrl       String?
  website         String?   @db.VarChar(255)
  status          String    @db.VarChar(30)
  isFeatured      Boolean   @default(false)
  productCount    Int       @default(0)
  country         String?   @db.VarChar(2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([slug])
  @@index([status])
  @@index([isFeatured])
  @@map("brands")
}

model Category {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(100)
  slug            String    @unique @db.VarChar(120)
  description     String?   @db.Text
  parentId        String?   @db.Uuid
  path            String[]  @default([])
  depth           Int       @default(0)
  status          String    @db.VarChar(30)
  imageUrl        String?
  iconUrl         String?
  sortOrder       Int       @default(0)
  productCount    Int       @default(0)
  isFeatured      Boolean   @default(false)
  hasChildren     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([slug])
  @@index([parentId])
  @@index([status])
  @@map("categories")
}

model Collection {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(150)
  slug            String    @unique @db.VarChar(180)
  description     String?   @db.Text
  type            String    @db.VarChar(30)
  status          String    @db.VarChar(30)
  imageUrl        String?
  bannerUrl       String?
  productCount    Int       @default(0)
  isFeatured      Boolean   @default(false)
  sortOrder       Int       @default(0)
  startAt         DateTime?
  endAt           DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  products        CollectionProduct[]

  @@index([slug])
  @@index([status])
  @@index([isFeatured])
  @@index([type])
  @@map("collections")
}

model CollectionProduct {
  collectionId    String    @db.Uuid
  productId       String    @db.Uuid
  sortOrder       Int       @default(0)
  addedAt         DateTime  @default(now())

  collection      Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
  @@map("collection_products")
}

model PricingRule {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(150)
  type            String    @db.VarChar(30)
  conditions      Json
  priceAdjustment Decimal   @db.Decimal(12, 2)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([type])
  @@index([isActive])
  @@map("pricing_rules")
}

// ═══════════════════════════════════════════════════════════════
// CART DOMAIN — cart-service
// Persistent models only: SavedItem, AbandonedCart, CartMerger
// (Cart, CartItem, CartCoupon, CartVoucher are Redis-primary)
// ═══════════════════════════════════════════════════════════════

model SavedItem {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  productId   String   @db.Uuid
  variantId   String?  @db.Uuid
  quantity    Int      @default(1)
  status      String   @db.VarChar(30) @default("active")
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([userId])
  @@index([userId, status])
  @@index([productId])
  @@index([userId, productId, variantId])
  @@map("saved_items")
}

model AbandonedCart {
  id                       String    @id @default(uuid()) @db.Uuid
  cartId                   String    @db.Uuid
  userId                   String?   @db.Uuid
  email                    String?   @db.VarChar(255)
  status                   String    @db.VarChar(30) @default("pending")
  reminderType             String    @db.VarChar(30) @default("email")
  itemCount                Int       @default(0)
  cartValue                Decimal   @db.Decimal(12, 2)
  currency                 String    @db.VarChar(3) @default("BDT")
  abandonedAt              DateTime  @default(now())
  remindersSent            Int       @default(0)
  lastReminderAt           DateTime?
  recoveredAt              DateTime?
  recoveredOrderId         String?   @db.Uuid
  recoveryDiscountPercent  Decimal?  @db.Decimal(5, 2)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  @@index([cartId])
  @@index([userId])
  @@index([status])
  @@index([abandonedAt])
  @@index([status, abandonedAt])
  @@map("abandoned_carts")
}

model CartMerger {
  id              String   @id @default(uuid()) @db.Uuid
  sourceCartId    String   @db.Uuid
  targetCartId    String   @db.Uuid
  strategy        String   @db.VarChar(30)
  itemsMerged     Int      @default(0)
  conflicts       Int      @default(0)
  mergedAt        DateTime @default(now())
  mergedBy        String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sourceCartId])
  @@index([targetCartId])
  @@index([mergedAt])
  @@map("cart_mergers")
}
