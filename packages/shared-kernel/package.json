      "require": "./dist/application/dtos/*.js",
      "default": "./dist/application/dtos/*.js"
    },
    "./application/events/*": {
      "types": "./dist/application/events/*.d.ts",
      "import": "./dist/application/events/*.js",
      "require": "./dist/application/events/*.js",
      "default": "./dist/application/events/*.js"
    },
    "./application/*": {
      "types": "./dist/application/*/index.d.ts",
      "import": "./dist/application/*/index.js",
      "require": "./dist/application/*/index.js",
      "default": "./dist/application/*/index.js"
    },
    "./infrastructure": {
      "types": "./dist/infrastructure/index.d.ts",
      "import": "./dist/infrastructure/index.js",
      "require": "./dist/infrastructure/index.js",
      "default": "./dist/infrastructure/index.js"
    },
    "./infrastructure/*": {
      "types": "./dist/infrastructure/*/index.d.ts",
      "import": "./dist/infrastructure/*/index.js",
      "require": "./dist/infrastructure/*/index.js",
      "default": "./dist/infrastructure/*/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js",
      "require": "./dist/interfaces/index.js",
      "default": "./dist/interfaces/index.js"
    },
    "./interfaces/*": {
      "types": "./dist/interfaces/*/index.d.ts",
      "import": "./dist/interfaces/*/index.js",
      "require": "./dist/interfaces/*/index.js",
      "default": "./dist/interfaces/*/index.js"
    },
    "./modules": {
      "types": "./dist/modules/index.d.ts",
      "import": "./dist/modules/index.js",
      "require": "./dist/modules/index.js",
      "default": "./dist/modules/index.js"
    },
    "./modules/*": {
      "types": "./dist/modules/*/index.d.ts",
      "import": "./dist/modules/*/index.js",
      "require": "./dist/modules/*/index.js",
      "default": "./dist/modules/*/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format:write": "prettier --write \"src/**/*.ts\"",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/cqrs": "^10.2.0",
    "@nestjs/event-emitter": "^2.0.0",
    "@nestjs/swagger": "^7.0.0",
    "@prisma/client": "^5.10.0",
    "@vubon/shared-config": "workspace:*",
    "@vubon/shared-constants": "workspace:*",
    "@vubon/shared-types": "workspace:*",
    "@vubon/shared-utils": "workspace:*",
    "bullmq": "^5.4.0",
    "express": "^4.18.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "prisma": "5.22.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
