{
  "name": "@vubon/shared-kernel",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "import": "./dist/domain/index.js",
      "require": "./dist/domain/index.js",
      "default": "./dist/domain/index.js"
    },
    "./domain/errors/*": {
      "types": "./dist/domain/errors/*.d.ts",
      "import": "./dist/domain/errors/*.js",
      "require": "./dist/domain/errors/*.js",
      "default": "./dist/domain/errors/*.js"
    },
    "./domain/base/*": {
      "types": "./dist/domain/base/*.d.ts",
      "import": "./dist/domain/base/*.js",
      "require": "./dist/domain/base/*.js",
      "default": "./dist/domain/base/*.js"
    },
    "./domain/primitives/*": {
      "types": "./dist/domain/primitives/*.d.ts",
      "import": "./dist/domain/primitives/*.js",
      "require": "./dist/domain/primitives/*.js",
      "default": "./dist/domain/primitives/*.js"
    },
    "./domain/types/*": {
      "types": "./dist/domain/types/*.d.ts",
      "import": "./dist/domain/types/*.js",
      "require": "./dist/domain/types/*.js",
      "default": "./dist/domain/types/*.js"
    },
    "./domain/interfaces/*": {
      "types": "./dist/domain/interfaces/*.d.ts",
      "import": "./dist/domain/interfaces/*.js",
      "require": "./dist/domain/interfaces/*.js",
      "default": "./dist/domain/interfaces/*.js"
    },
    "./domain/*": {
      "types": "./dist/domain/*/index.d.ts",
      "import": "./dist/domain/*/index.js",
      "require": "./dist/domain/*/index.js",
      "default": "./dist/domain/*/index.js"
    },
    "./application": {
      "types": "./dist/application/index.d.ts",
      "import": "./dist/application/index.js",
      "require": "./dist/application/index.js",
      "default": "./dist/application/index.js"
    },
    "./application/errors/*": {
      "types": "./dist/application/errors/*.d.ts",
      "import": "./dist/application/errors/*.js",
      "require": "./dist/application/errors/*.js",
      "default": "./dist/application/errors/*.js"
    },
    "./application/commands/*": {
      "types": "./dist/application/commands/*.d.ts",
      "import": "./dist/application/commands/*.js",
      "require": "./dist/application/commands/*.js",
      "default": "./dist/application/commands/*.js"
    },
    "./application/queries/*": {
      "types": "./dist/application/queries/*.d.ts",
      "import": "./dist/application/queries/*.js",
      "require": "./dist/application/queries/*.js",
      "default": "./dist/application/queries/*.js"
    },
    "./application/services/*": {
      "types": "./dist/application/services/*.d.ts",
      "import": "./dist/application/services/*.js",
      "require": "./dist/application/services/*.js",
      "default": "./dist/application/services/*.js"
    },
    "./application/sagas/*": {
      "types": "./dist/application/sagas/*.d.ts",
      "import": "./dist/application/sagas/*.js",
      "require": "./dist/application/sagas/*.js",
      "default": "./dist/application/sagas/*.js"
    },
    "./application/mappers/*": {
      "types": "./dist/application/mappers/*.d.ts",
      "import": "./dist/application/mappers/*.js",
      "require": "./dist/application/mappers/*.js",
      "default": "./dist/application/mappers/*.js"
    },
    "./application/dtos/*": {
      "types": "./dist/application/dtos/*.d.ts",
