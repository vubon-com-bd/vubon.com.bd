{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false,
    "module": "CommonJS",
    "target": "ES2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@vubon/shared-types": ["./src/index.ts"],
      "@vubon/shared-types/common": ["./src/common/index.ts"],
      "@vubon/shared-types/admin": ["./src/admin/index.ts"],
      "@vubon/shared-types/auth": ["./src/auth/index.ts"],
      "@vubon/shared-types/user": ["./src/user/index.ts"],
      "@vubon/shared-types/ai": ["./src/ai/index.ts"],
      "@vubon/shared-types/seo": ["./src/seo/index.ts"],
      "@vubon/shared-types/analytics": ["./src/analytics/index.ts"],
      "@vubon/shared-types/reporting": ["./src/reporting/index.ts"],
      "@vubon/shared-types/flash-sales": ["./src/flash-sales/index.ts"],
      "@vubon/shared-types/content": ["./src/content/index.ts"],
      "@vubon/shared-types/marketing": ["./src/marketing/index.ts"],
      "@vubon/shared-types/notification": ["./src/notification/index.ts"],
      "@vubon/shared-types/support": ["./src/support/index.ts"],
      "@vubon/shared-types/logistics": ["./src/logistics/index.ts"],
      "@vubon/shared-types/vendor": ["./src/vendor/index.ts"],
      "@vubon/shared-types/search": ["./src/search/index.ts"],
      "@vubon/shared-types/discovery": ["./src/discovery/index.ts"],
      "@vubon/shared-types/checkout": ["./src/checkout/index.ts"],
      "@vubon/shared-types/payment": ["./src/payment/index.ts"],
      "@vubon/shared-types/cart": ["./src/cart/index.ts"],
      "@vubon/shared-types/product-catalog": ["./src/product-catalog/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
